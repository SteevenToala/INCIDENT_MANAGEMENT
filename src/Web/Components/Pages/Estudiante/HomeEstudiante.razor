@page "/estudiante/home"
@attribute [Authorize(Roles = "Estudiante")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Web.Models.Estudiante
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IEstudiantePortalService EstudiantePortalService

<PageTitle>Inicio Estudiante</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudStack Spacing="1" Class="mb-6">
        <MudText Typo="Typo.h3">
            <MudIcon Icon="@Icons.Material.Filled.Home" Class="me-2" />
            Bienvenido, @userName
        </MudText>
        <MudText Typo="Typo.subtitle2" Class="text-muted">Resumen de tus incidencias y acciones rápidas.</MudText>
    </MudStack>

    @if (isLoading)
    {
        <MudGrid>
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSkeleton Height="150px" Animation="Animation.Wave" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@loadError</MudAlert>
    }
    else
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.BugReport" Color="Color.Primary" Class="me-1" />
                                Mis incidencias
                            </MudText>
                            <MudText Typo="Typo.h3">@dashboard.Counters.Total</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Reportadas en total</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="VerIncidencias">Ver todas</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Pending" Color="Color.Warning" Class="me-1" />
                                Pendientes
                            </MudText>
                            <MudText Typo="Typo.h3">@dashboard.Counters.Pendientes</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Sin iniciar</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="VerPendientes">Ver detalles</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Autorenew" Color="Color.Info" Class="me-1" />
                                En proceso
                            </MudText>
                            <MudText Typo="Typo.h3">@dashboard.Counters.EnProceso</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Atendidas actualmente</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="VerEnProceso">Seguimiento</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="me-1" />
                                Resueltas
                            </MudText>
                            <MudText Typo="Typo.h3">@dashboard.Counters.Resueltos</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Cerradas exitosamente</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="VerResueltas">Historial</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid GutterSize="3">
            <MudItem xs="12" md="8">
                <MudPaper Elevation="3" Class="pa-4 h-100">
                    <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h5">Últimas incidencias</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="VerIncidencias">Ver todas</MudButton>
                    </MudStack>

                    @if (!dashboard.UltimasIncidencias.Any())
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Aún no has registrado incidencias.</MudAlert>
                    }
                    else
                    {
                        <MudList Dense="true">
                            @foreach (var incidente in dashboard.UltimasIncidencias)
                            {
                                <MudListItem Class="align-start">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@incidente.Titulo</MudText>
                                        <MudText Typo="Typo.body2" Class="text-muted">@incidente.ComputadoraNombre · @incidente.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</MudText>
                                    </MudStack>
                                    <MudChip Color="@StatusColor(incidente.Estado)" Variant="Variant.Outlined" Size="Size.Small" Class="ms-auto">@incidente.Estado</MudChip>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="3" Class="pa-4 h-100">
                    <MudText Typo="Typo.h5" Class="mb-3">Acciones rápidas</MudText>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NuevaIncidencia">Nueva incidencia</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="IrBaseConocimiento">Base de conocimiento</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private EstudianteDashboardModel dashboard = new();
    private bool isLoading = true;
    private string? loadError;
    private string userName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!user.IsInRole("Estudiante"))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userName = user.Identity?.Name ?? user.FindFirstValue(System.Security.Claims.ClaimTypes.Email) ?? "Estudiante";
        var userId = user.GetUserId();
        if (userId is null)
        {
            loadError = "No pudimos identificar tu usuario.";
            isLoading = false;
            return;
        }

        try
        {
            dashboard = await EstudiantePortalService.GetDashboardAsync(userId.Value);
        }
        catch (Exception ex)
        {
            loadError = "No pudimos cargar tu panel.";
            Console.WriteLine($"[HomeEstudiante] Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color StatusColor(string estado) => estado.ToLowerInvariant() switch
    {
        "abierto" => Color.Warning,
        "en proceso" => Color.Info,
        "resuelto" or "cerrado" => Color.Success,
        _ => Color.Default
    };

    private void VerIncidencias() => Navigation.NavigateTo("/estudiante/incidencias");
    private void VerPendientes() => Navigation.NavigateTo("/estudiante/incidencias?estado=abierto");
    private void VerEnProceso() => Navigation.NavigateTo("/estudiante/incidencias?estado=en%20proceso");
    private void VerResueltas() => Navigation.NavigateTo("/estudiante/incidencias?estado=resuelto");
    private void NuevaIncidencia() => Navigation.NavigateTo("/estudiante/incidencias/nuevo");
    private void IrBaseConocimiento() => Navigation.NavigateTo("/estudiante/base-conocimiento");
}
