@page "/estudiante/incidencias/nuevo"
@attribute [Authorize(Roles = "Estudiante")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IEstudiantePortalService EstudiantePortalService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Nueva incidencia</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudStack Spacing="1" Class="mb-4">
        <MudText Typo="Typo.h4">Reportar incidencia</MudText>
        <MudText Typo="Typo.subtitle2" Class="text-muted">Describe el problema para que el equipo de soporte pueda ayudarte.</MudText>
    </MudStack>

    @if (isLoading)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudSkeleton Height="250px" Animation="Animation.Wave" />
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@loadError</MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-5">
            <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <MudGrid GutterSize="2">
                    <MudItem xs="12">
                        <MudSelect T="int?"
                                   @bind-Value="formModel.ComputadoraID"
                                   Label="Computadora"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   FullWidth="true"
                                   HelperText="Selecciona el equipo afectado"
                                   Required="true"
                                   Disabled="isSubmitting">
                            <MudSelectItem Value="@( (int?)null )" Disabled="true">Selecciona una opción...</MudSelectItem>
                            @foreach (var option in computadoras)
                            {
                                <MudSelectItem T="int?" Value="@((int?)option.Id)">@option.Nombre (@option.Descripcion)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.Titulo"
                                      Label="Título"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      MaxLength="200"
                                      FullWidth="true"
                                      Disabled="isSubmitting" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="formModel.Descripcion"
                                      Label="Descripción detallada"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      Lines="4"
                                      FullWidth="true"
                                      Disabled="isSubmitting" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string"
                                   @bind-Value="formModel.Prioridad"
                                   Label="Prioridad"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   FullWidth="true"
                                   Required="true"
                                   Disabled="isSubmitting">
                            <MudSelectItem T="string" Value="@PrioridadAlta">@PrioridadAlta</MudSelectItem>
                            <MudSelectItem T="string" Value="@PrioridadMedia">@PrioridadMedia</MudSelectItem>
                            <MudSelectItem T="string" Value="@PrioridadBaja">@PrioridadBaja</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudStack Direction="Row" Spacing="2" Class="mt-4">
                    <MudButton Type="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Send" Class="me-2" />
                            <span>Enviar reporte</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="isSubmitting" OnClick="Volver">
                        Cancelar
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    private const string PrioridadAlta = "Alta";
    private const string PrioridadMedia = "Media";
    private const string PrioridadBaja = "Baja";

    private NuevaIncidenciaModel formModel = new();
    private List<ComputadoraOption> computadoras = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private int? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!user.IsInRole("Estudiante"))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userId = user.GetUserId();
        if (userId is null)
        {
            loadError = "No pudimos identificar tu usuario.";
            isLoading = false;
            return;
        }

        try
        {
            computadoras = (await EstudiantePortalService.GetComputadorasAsync()).ToList();
            if (!computadoras.Any())
            {
                loadError = "Aún no hay computadoras configuradas. Contacta al administrador.";
            }
        }
        catch (Exception ex)
        {
            loadError = "No pudimos cargar las computadoras disponibles.";
            Console.WriteLine($"[NuevaIncidencia] Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (userId is null)
        {
            Snackbar.Add("No pudimos validar tu sesión. Inicia nuevamente.", Severity.Error);
            return;
        }

        isSubmitting = true;
        try
        {
            await EstudiantePortalService.CrearIncidenteAsync(formModel, userId.Value);
            Snackbar.Add("Incidencia registrada con éxito", Severity.Success);
            Navigation.NavigateTo("/estudiante/incidencias");
        }
        catch (Exception ex)
        {
            Snackbar.Add("No pudimos registrar la incidencia. Intenta más tarde.", Severity.Error);
            Console.WriteLine($"[NuevaIncidencia] Error: {ex}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Volver() => Navigation.NavigateTo("/estudiante/incidencias");
}
