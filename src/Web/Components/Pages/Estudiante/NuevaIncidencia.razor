@page "/estudiante/incidencias/nuevo"
@attribute [Authorize(Roles = "Estudiante")]
@rendermode InteractiveServer
@inject IEstudiantePortalService EstudiantePortalService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Nueva incidencia</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudStack Spacing="1" Class="mb-4">
        <MudText Typo="Typo.h4">Reportar incidencia</MudText>
        <MudText Typo="Typo.subtitle2" Class="text-muted">Describe el problema para que el equipo de soporte pueda ayudarte.</MudText>
    </MudStack>

    @if (isLoading)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudSkeleton Height="250px" Animation="Animation.Wave" />
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@loadError</MudAlert>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-5">
            <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">
                        <label for="computadora-select">Computadora</label>
                        <select id="computadora-select" class="form-control" @bind="formModel.ComputadoraID" required>
                            <option value="">-- Selecciona una computadora --</option>
                            @foreach (var comp in computadoras)
                            {
                                <option value="@comp.Id">@comp.Nombre - @comp.Descripcion</option>
                            }
                        </select>

                    <MudTextField @bind-Value="formModel.Titulo"
                                  Label="Título"
                                  Id="titulo-field"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="El título es obligatorio"
                                  MaxLength="200" />

                    <MudTextField @bind-Value="formModel.Descripcion"
                                  Label="Descripción detallada"
                                  Id="descripcion-field"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="La descripción es obligatoria"
                                  Lines="4" />

                    <label for="prioridad-select">Prioridad</label>
                    <select id="prioridad-select" class="form-control" @bind="formModel.Prioridad" required>
                        <option value="Alta">Alta</option>
                        <option value="Media">Media (Recomendada)</option>
                        <option value="Baja">Baja</option>
                    </select>
                </MudStack>

                <MudStack Direction="Row" Spacing="2" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Disabled="isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Send" Class="me-2" />
                            <span>Enviar reporte</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Text" 
                               Color="Color.Secondary" 
                               Disabled="isSubmitting" 
                               OnClick="Volver">
                        Cancelar
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    private const string prioridadAlta = "Alta";
    private const string prioridadMedia = "Media";
    private const string prioridadBaja = "Baja";

    private NuevaIncidenciaModel formModel = new();
    private List<ComputadoraOption> computadoras = new();
    // MudSelect no necesita propiedad intermedia
    private bool isLoading = true;
    private bool isSubmitting;
    private string? loadError;
    private int? userId;

    // MudSelect no necesita SearchFunc

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!user.IsInRole("Estudiante"))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userId = user.GetUserId();
        if (userId is null)
        {
            loadError = "No pudimos identificar tu usuario.";
            isLoading = false;
            return;
        }

        try
        {
            computadoras = (await EstudiantePortalService.GetComputadorasAsync()).ToList();
            Console.WriteLine($"[NuevaIncidencia] Computadoras cargadas: {computadoras.Count}");
            foreach (var comp in computadoras)
            {
                Console.WriteLine($"  - ID: {comp.Id}, Nombre: {comp.Nombre}, Desc: {comp.Descripcion}");
            }
            
            if (!computadoras.Any())
            {
                loadError = "Aún no hay computadoras configuradas. Contacta al administrador.";
            }
        }
        catch (Exception ex)
        {
            loadError = "No pudimos cargar las computadoras disponibles.";
            Console.WriteLine($"[NuevaIncidencia] Error: {ex}");
            Console.WriteLine($"[NuevaIncidencia] Stack: {ex.StackTrace}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit(EditContext context)
    {
        if (userId is null)
        {
            Snackbar.Add("No pudimos validar tu sesión. Inicia nuevamente.", Severity.Error);
            return;
        }

        if (!formModel.ComputadoraID.HasValue)
        {
            Snackbar.Add("Debes seleccionar una computadora", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            await EstudiantePortalService.CrearIncidenteAsync(formModel, userId.Value);
            Snackbar.Add("Incidencia registrada con éxito", Severity.Success);
            Navigation.NavigateTo("/estudiante/incidencias");
        }
        catch (Exception ex)
        {
            Snackbar.Add("No pudimos registrar la incidencia. Intenta más tarde.", Severity.Error);
            Console.WriteLine($"[NuevaIncidencia] Error al crear: {ex}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Volver() => Navigation.NavigateTo("/estudiante/incidencias");
}
