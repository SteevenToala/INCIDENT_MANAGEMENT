    private Color GetPrioridadColor(string prioridad) => prioridad switch
    {
        "Alta" => Color.Error,
        "Media" => Color.Warning,
        _ => Color.Info
    };

    private Color GetEstadoColor(string estado) => estado switch
    {
        "Abierto" => Color.Info,
        "Asignado" => Color.Warning,
        "En Proceso" => Color.Primary,
        "Resuelto" => Color.Success,
        "Cerrado" => Color.Dark,
        _ => Color.Default
    };

    private Color GetEstadoAsignacionColor(string estado) => estado switch
    {
        "Pendiente" => Color.Warning,
        "Aceptado" => Color.Info,
        "Completado" => Color.Success,
        _ => Color.Default
    };

    // Métodos para la línea de tiempo
    private string GetEstadoActual()
    {
        // Flujo basado en Estados del Incidente y EstadoAsignacion
        if (incidente == null) return "Reportado";
        
        // 6. Cerrado - Estado final
        if (incidente.Estado == "Cerrado")
            return "Cerrado";
        
        // 5. Resuelto - Esperando cierre
        if (incidente.Estado == "Resuelto")
            return "Resuelto";
        
        // Estados basados en asignación (usar primeraAsignacion para que todos vean el mismo estado)
        if (primeraAsignacion != null)
        {
            // 4. Trabajo Completado - El laboratorista marcó como completado
            if (primeraAsignacion.EstadoAsignacion == "Completado")
                return "Completado";
            
            // 3. Trabajo Iniciado - El laboratorista aceptó y está trabajando
            if (primeraAsignacion.EstadoAsignacion == "Aceptado")
                return "Iniciado";
            
            // 2. Asignado - Tiene asignación pero pendiente de aceptar
            if (primeraAsignacion.EstadoAsignacion == "Pendiente")
                return "Asignado";
        }
        
        // 1. Reportado - Sin asignación
        return "Reportado";
    }

    private Color GetTimelineColor(string paso)
    {
        var estadoActual = GetEstadoActual();
        var pasos = new[] { "Reportado", "Asignado", "Iniciado", "Completado", "Resuelto", "Cerrado" };
        var indiceActual = Array.IndexOf(pasos, estadoActual);
        var indicePaso = Array.IndexOf(pasos, paso);

        if (indicePaso < indiceActual)
            return Color.Success; // Completado
        else if (indicePaso == indiceActual)
            return paso switch
            {
                "Reportado" => Color.Info,
                "Asignado" => Color.Warning,
                "Iniciado" => Color.Primary,
                "Completado" => Color.Success,
                "Resuelto" => Color.Success,
                "Cerrado" => Color.Dark,
                _ => Color.Default
            };
        else
            return Color.Default; // Pendiente
    }

    private Size GetTimelineSize(string paso)
    {
        var estadoActual = GetEstadoActual();
        return paso == estadoActual ? Size.Medium : Size.Small;
    }

    private Variant GetTimelineVariant(string paso)
    {
        var estadoActual = GetEstadoActual();
        var pasos = new[] { "Reportado", "Asignado", "Iniciado", "Completado", "Resuelto", "Cerrado" };
        var indiceActual = Array.IndexOf(pasos, estadoActual);
        var indicePaso = Array.IndexOf(pasos, paso);

        if (indicePaso <= indiceActual)
            return Variant.Filled; // Ya completado o actual
        else
            return Variant.Outlined; // Pendiente
    }

