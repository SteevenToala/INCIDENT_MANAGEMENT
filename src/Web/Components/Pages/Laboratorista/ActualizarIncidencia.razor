            await AsignacionService.AceptarAsignacionAsync(asignacionActual.AsignacionID, userId.Value);
            
            // Notificar al estudiante
            if (incidente.UsuarioReportadorID.HasValue)
            {
                var tecnico = await UsuarioRepository.GetByIdAsync(userId.Value);
                await NotificacionService.CrearNotificacionAsync(
                    incidente.UsuarioReportadorID.Value,
                    incidente.IncidenteID,
                    "Trabajo Iniciado",
                    $"El técnico {tecnico?.NombreCompleto} ha comenzado a trabajar en tu incidente '{incidente.CodigoIncidente}'.",
