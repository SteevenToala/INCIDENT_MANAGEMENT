    private async Task ReasignarIncidente()
    {
        if (incidente == null || userId == null || string.IsNullOrEmpty(reasignacionForm.TecnicoSeleccionadoId) || string.IsNullOrEmpty(reasignacionForm.Motivo))
            return;

        isSubmitting = true;
        try
        {
            // Completar la asignación actual con el motivo de reasignación
            if (asignacionActual != null)
            {
                var notasReasignacion = $"Reasignado a otro técnico. Motivo: {reasignacionForm.Motivo}";
                await AsignacionService.CompletarAsignacionAsync(asignacionActual.AsignacionID, notasReasignacion);
            }

            // Crear nueva asignación para el otro técnico
            var nuevaAsignacion = new CreateAsignacionDto
            {
                IncidenteID = incidente.IncidenteID,
                UsuarioAsignadoID = int.Parse(reasignacionForm.TecnicoSeleccionadoId),
                TipoAsignacion = "Reasignado",
                Notas = $"Reasignado desde técnico anterior. Motivo: {reasignacionForm.Motivo}"
            };
            await AsignacionService.AsignarIncidenteAsync(nuevaAsignacion);

            // Notificar al estudiante sobre la reasignación
            if (incidente.UsuarioReportadorID.HasValue)
            {
                var nuevoTecnico = await UsuarioRepository.GetByIdAsync(int.Parse(reasignacionForm.TecnicoSeleccionadoId));
                await NotificacionService.CrearNotificacionAsync(
                    incidente.UsuarioReportadorID.Value,
                    incidente.IncidenteID,
                    "Incidente Reasignado",
                    $"Tu incidente '{incidente.CodigoIncidente}' ha sido reasignado a {nuevoTecnico?.NombreCompleto} para continuar con su resolución.",
                    "Reasignacion",
                    $"/estudiante/incidencias/detalle?id={incidente.IncidenteID}"
                );
            }

            Snackbar.Add("Incidente reasignado exitosamente", Severity.Success);
            
            // Limpiar formulario
            reasignacionForm = new ReasignacionFormModel();
            mostrarReasignacion = false;
            
            await CargarIncidencia();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al reasignar incidente: {ex.Message}", Severity.Error);
            Console.WriteLine($"[ActualizarIncidencia] Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
