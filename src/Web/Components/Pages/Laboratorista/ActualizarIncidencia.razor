@page "/laboratorista/asignaciones/actualizar"
@attribute [Authorize(Roles = "Laboratorista")]
@rendermode InteractiveServer
@using MudBlazor
@using IncidentManagement.Application.Interfaces
@using IncidentManagement.Application.DTOs
@using IncidentManagement.Domain.Entities
@inject IIncidenteService IncidenteService
@inject IAsignacionService AsignacionService
@inject IBaseConocimientoService BaseConocimientoService
@inject IUsuarioRepository UsuarioRepository
@inject INotificacionService NotificacionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Detalle del Incidente</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" 
               Color="Color.Default" OnClick="Volver" Class="mb-3">
        Volver a Mis Tareas
    </MudButton>
    
    <MudText Typo="Typo.h4" Class="mb-4">Detalle del Incidente</MudText>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (incidente != null)
    {
        <MudGrid>
            <!-- Columna Izquierda: Información del Incidente -->
            <MudItem xs="12" md="8">
                <MudPaper Elevation="2" Class="pa-4 mb-4">
                    <MudStack Spacing="3">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <MudText Typo="Typo.h5">@incidente.CodigoIncidente</MudText>
                            <MudChip Color="@GetEstadoColor(incidente.Estado)" Size="Size.Medium">
                                @incidente.Estado
                            </MudChip>
                        </div>
                        
                        <MudDivider />
                        
                        <MudText Typo="Typo.h6">@incidente.Titulo</MudText>
                        
                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudChip Icon="@Icons.Material.Filled.Flag" Color="@GetPrioridadColor(incidente.Prioridad)" Size="Size.Small">
                                Prioridad: @incidente.Prioridad
                            </MudChip>
                            <MudChip Icon="@Icons.Material.Filled.Computer" Size="Size.Small">
                                @incidente.ComputadoraNombre
                            </MudChip>
                            <MudChip Icon="@Icons.Material.Filled.Room" Size="Size.Small">
                                @incidente.LaboratorioNombre
                            </MudChip>
                        </MudStack>
                        
                        <MudText><strong>Descripción:</strong></MudText>
                        <MudText Class="pa-3" Style="background-color: #f5f5f5; border-radius: 4px;">
                            @incidente.Descripcion
                        </MudText>
                        
                        <MudStack Row="true" Spacing="4">
                            <MudText><strong>Reportado por:</strong> @incidente.UsuarioReportador</MudText>
                            <MudText><strong>Fecha:</strong> @incidente.FechaReporte.ToString("dd/MM/yyyy HH:mm")</MudText>
                        </MudStack>

                        @if (asignacionActual != null)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.subtitle1"><strong>Asignación Actual</strong></MudText>
                            <MudStack Row="true" Spacing="3" Class="flex-wrap">
                                <MudChip Icon="@Icons.Material.Filled.AssignmentInd" 
                                         Color="@GetEstadoAsignacionColor(asignacionActual.EstadoAsignacion)" 
                                         Size="Size.Small">
                                    @asignacionActual.EstadoAsignacion
                                </MudChip>
                                <MudText><strong>Asignado a:</strong> @asignacionActual.NombreTecnico</MudText>
                                @if (asignacionActual.FechaAsignacion.HasValue)
                                {
                                    <MudText><strong>Desde:</strong> @asignacionActual.FechaAsignacion.Value.ToString("dd/MM/yyyy HH:mm")</MudText>
                                }
                            </MudStack>
                            
                            @if (!string.IsNullOrEmpty(asignacionActual.Notas))
                            {
                                <MudText><strong>Notas de asignación:</strong></MudText>
                                <MudText Class="pa-2" Style="background-color: #f5f5f5; border-radius: 4px; font-size: 0.9em;">
                                    @asignacionActual.Notas
                                </MudText>
                            }
                        }
                    </MudStack>
                </MudPaper>

                <!-- Panel de Acciones según el Estado -->
                <MudPaper Elevation="2" Class="pa-4">
                    @if (asignacionActual == null)
                    {
                        <MudAlert Severity="Severity.Info">
                            Este incidente no está asignado a ti. Solo puedes visualizar la información.
                        </MudAlert>
                    }
                    else if (asignacionActual != null && asignacionActual.EstadoAsignacion == "Pendiente" && incidente.Estado != "Cerrado")
                    {
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="me-2" />
                            Aceptar Asignación
                        </MudText>
                        <MudText Class="mb-3">
                            Para comenzar a trabajar en este incidente, primero debes aceptar la asignación.
                        </MudText>
                        <MudStack Direction="Row" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large"
                                       OnClick="AceptarAsignacion" Disabled="isSubmitting">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Class="me-2" />
                                Aceptar y Comenzar a Trabajar
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large"
                                       OnClick="RechazarAsignacion" Disabled="isSubmitting">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="me-2" />
                                Rechazar Asignación
                            </MudButton>
                        </MudStack>
                    }
                    else if (asignacionActual != null && asignacionActual.EstadoAsignacion == "Aceptado" && incidente.Estado != "Cerrado")
                    {
                        <!-- Paso 3: Trabajando - Botón para completar trabajo o reasignar -->
                        <MudText Typo="Typo.h6" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="me-2" />
                            Trabajando en el Incidente
                        </MudText>
                        <MudText Class="mb-3">
                            Cuando hayas terminado de trabajar en el incidente, marca el trabajo como completado.
                        </MudText>
                        <MudStack Direction="Row" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                       OnClick="CompletarTrabajo" Disabled="isSubmitting">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="me-2" />
                                Completar Trabajo
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large"
                                       OnClick="() => mostrarReasignacion = true" Disabled="isSubmitting">
                                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="me-2" />
                                Reasignar a Otro Técnico
                            </MudButton>
                        </MudStack>

                        @if (mostrarReasignacion)
                        {
                            <MudPaper Elevation="1" Class="pa-4 mt-4" Style="background-color: #fff3cd;">
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="me-2" />
                                    Reasignar Incidente
                                </MudText>
                                <MudText Class="mb-3">
                                    Si no puedes resolver este incidente, puedes reasignarlo a otro técnico.
                                </MudText>

                                <MudStack Spacing="3">
                                    <div>
                                        <label for="tecnico-reasignar-select"><strong>Seleccionar Nuevo Técnico</strong></label>
                                        <select id="tecnico-reasignar-select" class="form-control" @bind="reasignacionForm.TecnicoSeleccionadoId" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                            <option value="">-- Seleccionar Laboratorista --</option>
                                            @foreach (var tecnico in tecnicos.Where(t => t.UsuarioID.ToString() != userId.ToString()))
                                            {
                                                <option value="@tecnico.UsuarioID">@tecnico.NombreCompleto</option>
                                            }
                                        </select>
                                    </div>

                                    <MudTextField @bind-Value="reasignacionForm.Motivo"
                                                  Label="Motivo de la Reasignación"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Required="true"
                                                  Placeholder="Explica por qué necesitas reasignar este incidente..." />

                                    <MudStack Direction="Row" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Medium"
                                                   OnClick="ReasignarIncidente" 
                                                   Disabled="isSubmitting || string.IsNullOrEmpty(reasignacionForm.TecnicoSeleccionadoId) || string.IsNullOrEmpty(reasignacionForm.Motivo)">
                                            @if (isSubmitting)
                                            {
                                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                                <span>Reasignando...</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="me-2" />
                                                <span>Confirmar Reasignación</span>
                                            }
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                                                   OnClick="() => mostrarReasignacion = false" Disabled="isSubmitting">
                                            Cancelar
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                    else if (asignacionActual != null && asignacionActual.EstadoAsignacion == "Completado" && incidente.Estado != "Resuelto" && incidente.Estado != "Cerrado")
                    {
                        @if (asignacionActual.Notas != null && asignacionActual.Notas.Contains("Reasignado a otro técnico"))
                        {
                            <!-- Si fue reasignado, mostrar mensaje informativo -->
                            <MudAlert Severity="Severity.Info">
                                <strong>Incidente Reasignado</strong>
                                <div>Este incidente fue reasignado a otro técnico. Ya no puedes realizar acciones sobre él.</div>
                                @if (!string.IsNullOrEmpty(asignacionActual.Notas))
                                {
                                    <div class="mt-2"><em>@asignacionActual.Notas</em></div>
                                }
                            </MudAlert>
                        }
                        else
                        {
                            <!-- Paso 4: Trabajo Completado - Registrar solución -->
                            <MudText Typo="Typo.h6" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Construction" Class="me-2" />
                                Registrar Solución
                            </MudText>
                            <MudText Class="mb-3">
                                Describe la solución aplicada. Esta información se guardará en la base de conocimientos.
                            </MudText>
                            
                            <EditForm Model="@formModel" OnValidSubmit="ResolverIncidente">
                                <MudStack Spacing="3">
                                    <MudTextField @bind-Value="formModel.TituloSolucion"
                                                  Label="Título de la Solución"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  Placeholder="Ej: Reinstalación de drivers de red" />

                                    <MudTextField @bind-Value="formModel.DescripcionSolucion"
                                                  Label="Descripción Detallada de la Solución"
                                                  Variant="Variant.Outlined"
                                                  Lines="6"
                                                  Required="true"
                                                  Placeholder="Describe paso a paso cómo se resolvió el problema..." />

                                    <div>
                                        <label for="categoria-select"><strong>Categoría</strong></label>
                                        <select id="categoria-select" class="form-control" @bind="formModel.Categoria" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                            <option value="">-- Seleccionar --</option>
                                            <option value="Hardware">Hardware</option>
                                            <option value="Software">Software</option>
                                            <option value="Red">Red</option>
                                            <option value="Sistema Operativo">Sistema Operativo</option>
                                            <option value="Periféricos">Periféricos</option>
                                            <option value="Otro">Otro</option>
                                        </select>
                                    </div>

                                    <MudTextField @bind-Value="formModel.PalabrasClaveStr"
                                                  Label="Palabras Clave (separadas por comas)"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="red, drivers, windows, configuración" />

                                    <MudStack Direction="Row" Spacing="2">
                                        <MudButton ButtonType="ButtonType.Submit" 
                                                   Variant="Variant.Filled" 
                                                   Color="Color.Success" 
                                                   Size="Size.Large"
                                                   Disabled="isSubmitting">
                                            @if (isSubmitting)
                                            {
                                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                                <span>Resolviendo...</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="me-2" />
                                                <span>Marcar como Resuelto</span>
                                            }
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </EditForm>
                        }
                    }
                    else if (incidente.Estado == "Resuelto")
                    {
                        <MudAlert Severity="Severity.Success">
                            <strong>Incidente Resuelto</strong>
                            @if (asignacionActual?.FechaCompletacion.HasValue == true)
                            {
                                <div>Fecha de resolución: @asignacionActual.FechaCompletacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </MudAlert>
                        
                        @if (userId == incidente.TecnicoID)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                       Class="mt-3" OnClick="CerrarIncidente" Disabled="isSubmitting" Size="Size.Large">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="me-2" />
                                Cerrar Incidente
                            </MudButton>
                        }
                    }
                    else if (incidente.Estado == "Cerrado")
                    {
                        <MudAlert Severity="Severity.Info">
                            <strong>Incidente Cerrado</strong>
                            <div>Este incidente está cerrado. No se pueden realizar más acciones.</div>
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>

            <!-- Columna Derecha: Línea de Tiempo -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-4" Style="position: sticky; top: 20px;">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="me-2" />
                        Línea de Tiempo
                    </MudText>
                    <MudDivider Class="mb-3" />
                    
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                        <!-- 1. Incidente Reportado -->
                        <MudTimelineItem Color="@(GetTimelineColor("Reportado"))" 
                                         Size="@(GetTimelineSize("Reportado"))"
                                         Variant="@(GetTimelineVariant("Reportado"))">
                            <ItemOpposite>
                                @if (incidente.FechaCreacion != default)
                                {
                                    <MudText Typo="Typo.caption">@incidente.FechaCreacion.ToString("dd/MM HH:mm")</MudText>
                                }
                            </ItemOpposite>
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>1. Incidente Reportado</strong></MudText>
                                <MudText Typo="Typo.caption">Por @incidente.UsuarioReportador</MudText>
                                @if (GetEstadoActual() == "Reportado")
                                {
                                    <MudChip Size="Size.Small" Color="Color.Info" Class="mt-1">Actual</MudChip>
                                }
                            </ItemContent>
                        </MudTimelineItem>

                        <!-- 2. Asignado -->
                        <MudTimelineItem Color="@(GetTimelineColor("Asignado"))" 
                                         Size="@(GetTimelineSize("Asignado"))"
                                         Variant="@(GetTimelineVariant("Asignado"))">
                            <ItemOpposite>
                                @if (primeraAsignacion?.FechaAsignacion.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption">@primeraAsignacion.FechaAsignacion.Value.ToString("dd/MM HH:mm")</MudText>
                                }
                            </ItemOpposite>
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>2. Asignado a Laboratorista</strong></MudText>
                                @if (primeraAsignacion != null)
                                {
                                    <MudText Typo="Typo.caption">A @primeraAsignacion.NombreTecnico</MudText>
                                    @if (!string.IsNullOrEmpty(primeraAsignacion.TipoAsignacion))
                                    {
                                        <MudChip Size="Size.Small" Variant="Variant.Text">@primeraAsignacion.TipoAsignacion</MudChip>
                                    }
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pendiente de asignación</MudText>
                                }
                                @if (GetEstadoActual() == "Asignado")
                                {
                                    <MudChip Size="Size.Small" Color="Color.Warning" Class="mt-1">Actual</MudChip>
                                }
                            </ItemContent>
                        </MudTimelineItem>

                        <!-- 3. Trabajo Iniciado (Aceptado) -->
                        <MudTimelineItem Color="@(GetTimelineColor("Iniciado"))" 
                                         Size="@(GetTimelineSize("Iniciado"))"
                                         Variant="@(GetTimelineVariant("Iniciado"))">
                            <ItemOpposite>
                                @if (primeraAsignacion?.FechaAceptacion.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption">@primeraAsignacion.FechaAceptacion.Value.ToString("dd/MM HH:mm")</MudText>
                                }
                            </ItemOpposite>
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>3. Trabajo Iniciado</strong></MudText>
                                @if (primeraAsignacion?.FechaAceptacion.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption">Por @primeraAsignacion.NombreTecnico</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Esperando aceptación del laboratorista</MudText>
                                }
                                @if (GetEstadoActual() == "Iniciado")
                                {
                                    <MudChip Size="Size.Small" Color="Color.Primary" Class="mt-1">Actual</MudChip>
                                }
                            </ItemContent>
                        </MudTimelineItem>

                        <!-- 4. Trabajo Completado -->
                        <MudTimelineItem Color="@(GetTimelineColor("Completado"))" 
                                         Size="@(GetTimelineSize("Completado"))"
                                         Variant="@(GetTimelineVariant("Completado"))">
                            <ItemOpposite>
                                @if (primeraAsignacion?.FechaCompletacion.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption">@primeraAsignacion.FechaCompletacion.Value.ToString("dd/MM HH:mm")</MudText>
                                }
                            </ItemOpposite>
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>4. Trabajo Completado</strong></MudText>
                                @if (primeraAsignacion?.FechaCompletacion.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption">Por @primeraAsignacion.NombreTecnico</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pendiente de resolución</MudText>
                                }
                                @if (GetEstadoActual() == "Completado")
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success" Class="mt-1">Actual</MudChip>
                                }
                            </ItemContent>
                        </MudTimelineItem>

                        <!-- 5. Incidente Resuelto -->
                        <MudTimelineItem Color="@(GetTimelineColor("Resuelto"))" 
                                         Size="@(GetTimelineSize("Resuelto"))"
                                         Variant="@(GetTimelineVariant("Resuelto"))">
                            <ItemOpposite>
                                @if (incidente.FechaResolucion.HasValue)
                                {
                                    <MudText Typo="Typo.caption">@incidente.FechaResolucion.Value.ToString("dd/MM HH:mm")</MudText>
                                }
                            </ItemOpposite>
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>5. Incidente Resuelto</strong></MudText>
                                @if (incidente.FechaResolucion.HasValue)
                                {
                                    <MudText Typo="Typo.caption">Guardado en Base de Conocimientos</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Pendiente de cierre</MudText>
                                }
                                @if (GetEstadoActual() == "Resuelto")
                                {
                                    <MudChip Size="Size.Small" Color="Color.Success" Class="mt-1">Actual</MudChip>
                                }
                            </ItemContent>
                        </MudTimelineItem>

                        <!-- 6. Incidente Cerrado -->
                        <MudTimelineItem Color="@(GetTimelineColor("Cerrado"))" 
                                         Size="@(GetTimelineSize("Cerrado"))"
                                         Variant="@(GetTimelineVariant("Cerrado"))">
                            <ItemContent>
                                <MudText Typo="Typo.body2"><strong>6. Incidente Cerrado</strong></MudText>
                                @if (incidente.Estado == "Cerrado")
                                {
                                    <MudText Typo="Typo.caption">Proceso finalizado</MudText>
                                    <MudChip Size="Size.Small" Color="Color.Dark" Class="mt-1">Actual</MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Estado final</MudText>
                                }
                            </ItemContent>
                        </MudTimelineItem>
                    </MudTimeline>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? IncidenteId { get; set; }

    private IncidenteDto? incidente;
    private AsignacionDto? asignacionActual;
    private AsignacionDto? primeraAsignacion;
    private List<AsignacionDto> todasAsignaciones = new();
    private bool tieneAsignacionActiva = false;
    private ResolverIncidenteModel formModel = new();
    private List<Usuario> tecnicos = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private int? userId;
    private bool mostrarReasignacion = false;
    private ReasignacionFormModel reasignacionForm = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userId = user.GetUserId();

        if (!IncidenteId.HasValue)
        {
            errorMessage = "No se especificó un incidente.";
            isLoading = false;
            return;
        }

        await CargarIncidencia();
        
        // Cargar técnicos para reasignación
        await CargarTecnicos();
    }

    private async Task CargarTecnicos()
    {
        try
        {
            var usuariosLab = await UsuarioRepository.GetByRolAsync("Laboratorista");
            tecnicos = usuariosLab.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ActualizarIncidencia] Error al cargar técnicos: {ex.Message}");
        }
    }

    private async Task CargarIncidencia()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            incidente = await IncidenteService.GetByIdAsync(IncidenteId!.Value);
            
            if (incidente == null)
            {
                errorMessage = "El incidente no existe.";
                return;
            }

            // Cargar todas las asignaciones para la línea de tiempo
            todasAsignaciones = (await AsignacionService.GetAsignacionesByIncidenteAsync(incidente.IncidenteID)).ToList();
            
            // Cargar asignación actual del usuario (la más reciente)
            if (userId.HasValue)
            {
                asignacionActual = todasAsignaciones
                    .Where(a => a.UsuarioAsignadoID == userId.Value)
                    .OrderByDescending(a => a.FechaAsignacion)
                    .FirstOrDefault();
            }
            
            // Obtener la asignación activa más reciente para el timeline (no completada por reasignación)
            primeraAsignacion = todasAsignaciones
                .Where(a => a.EstadoAsignacion != "Completado" || 
                           (a.Notas == null || !a.Notas.Contains("Reasignado a otro técnico")))
                .OrderByDescending(a => a.FechaAsignacion)
                .FirstOrDefault();
            
            // Si no hay asignación activa, usar la primera
            if (primeraAsignacion == null)
            {
                primeraAsignacion = todasAsignaciones.OrderBy(a => a.FechaAsignacion).FirstOrDefault();
            }
            
            // Verificar si existe alguna asignación activa (no completada en todos los estados)
            tieneAsignacionActiva = todasAsignaciones.Any(a => 
                a.EstadoAsignacion == "Pendiente" || 
                a.EstadoAsignacion == "Aceptado" || 
                (a.EstadoAsignacion == "Completado" && (a.Notas == null || !a.Notas.Contains("Reasignado a otro técnico")))
            );
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar el incidente.";
            Console.WriteLine($"[ActualizarIncidencia] Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AceptarAsignacion()
