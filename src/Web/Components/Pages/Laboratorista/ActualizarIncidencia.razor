    private async Task ResolverIncidente()
    {
        if (incidente == null || asignacionActual == null || userId == null) return;

        if (string.IsNullOrWhiteSpace(formModel.TituloSolucion) || string.IsNullOrWhiteSpace(formModel.DescripcionSolucion))
        {
            Snackbar.Add("Debes completar el título y la descripción de la solución", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            // 1. Actualizar estado del incidente a "Resuelto"
            var updateDto = new ActualizarEstadoDto
            {
                IncidenteID = incidente.IncidenteID,
                Estado = "Resuelto",
                Comentarios = $"Solución: {formModel.TituloSolucion}"
            };
            await IncidenteService.ActualizarEstadoAsync(updateDto);

            // 2. Guardar en la base de conocimientos
            var conocimientoDto = new CreateBaseConocimientoDto
            {
                Titulo = formModel.TituloSolucion,
                Problema = incidente.Descripcion,
                Solucion = formModel.DescripcionSolucion,
                Categoria = formModel.Categoria,
                PalabrasClaveStr = formModel.PalabrasClaveStr,
                IncidenteRelacionadoID = incidente.IncidenteID
            };
            await BaseConocimientoService.CreateAsync(conocimientoDto, userId.Value);

            // Notificar al estudiante que su incidente fue resuelto
            if (incidente.UsuarioReportadorID.HasValue)
            {
                await NotificacionService.CrearNotificacionAsync(
                    incidente.UsuarioReportadorID.Value,
                    incidente.IncidenteID,
                    "✅ Incidente Resuelto",
                    $"¡Buenas noticias! Tu incidente '{incidente.CodigoIncidente}' ha sido resuelto. Solución: {formModel.TituloSolucion}",
                    "Resuelto",
                    $"/estudiante/incidencias/detalle?id={incidente.IncidenteID}"
                );
            }

            Snackbar.Add("Incidente resuelto y solución guardada en la base de conocimientos", Severity.Success);
            await CargarIncidencia();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al resolver incidente: {ex.Message}", Severity.Error);
            Console.WriteLine($"[ActualizarIncidencia] Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task CerrarIncidente()
