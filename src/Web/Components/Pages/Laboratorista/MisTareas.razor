                                <option value="titulo">Título</option>
                                <option value="descripcion">Descripción</option>
                                <option value="reportador">Reportado por</option>
                                <option value="computadora">Computadora</option>
                                <option value="laboratorio">Laboratorio</option>
                            </select>
                            <MudTextField @bind-Value="searchString" Placeholder="Buscar" Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                        </div>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.IncidenteID)">ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.CodigoIncidente)">Código</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.Titulo)">Título</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.Prioridad)">Prioridad</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.EstudianteNombre)">Reportado por</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.ComputadoraNombre)">Computadora</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.LaboratorioNombre)">Laboratorio</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.FechaReporte)">Fecha</MudTableSortLabel></MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IncidenteID</MudTd>
                        <MudTd DataLabel="Código">@context.CodigoIncidente</MudTd>
                        <MudTd DataLabel="Título">@context.Titulo</MudTd>
                        <MudTd DataLabel="Prioridad">
                            <MudChip Color="@GetPriorityColor(context.Prioridad)" Size="Size.Small">@context.Prioridad</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Reportado por">@context.EstudianteNombre</MudTd>
                        <MudTd DataLabel="Computadora">@context.ComputadoraNombre</MudTd>
                        <MudTd DataLabel="Laboratorio">@context.LaboratorioNombre</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaReporte.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerDetalle(context.IncidenteID))">
                                Ver Detalle
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" HideRowsPerPage="true" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body1" Class="pa-4">No hay incidentes en proceso.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>
            
            <MudTabPanel Text="Resueltas" Icon="@Icons.Material.Filled.CheckCircle" BadgeData="@incidentesResueltas.Count">
                <MudTable Items="@incidentesResueltas" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true"
                          Filter="new Func<IncidenteDto, bool>(FilterFunc)" 
                          SortLabel="Ordenar por"
                          RowsPerPage="10">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Incidentes Resueltos</MudText>
                        <MudSpacer />
                        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                            <select @bind="laboratorioSeleccionadoId" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="">Todos los Laboratorios</option>
                                @foreach (var lab in laboratorios)
                                {
                                    <option value="@lab.LaboratorioID">@lab.Nombre</option>
                                }
                            </select>
                            <select @bind="rolSeleccionado" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="">Todos los roles</option>
                                <option value="Estudiante">Estudiantes</option>
                                <option value="Docente">Docentes</option>
                            </select>
                            <select @bind="criterioBusqueda" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="todos">Buscar en todos</option>
                                <option value="codigo">Código</option>
                                <option value="titulo">Título</option>
                                <option value="descripcion">Descripción</option>
                                <option value="reportador">Reportado por</option>
                                <option value="computadora">Computadora</option>
                                <option value="laboratorio">Laboratorio</option>
                            </select>
                            <MudTextField @bind-Value="searchString" Placeholder="Buscar" Adornment="Adornment.Start" 
