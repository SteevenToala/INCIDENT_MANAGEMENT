@page "/laboratorista/home"
@rendermode InteractiveServer
@using MudBlazor
@using IncidentManagement.Application.Interfaces
@inject AuthenticationStateProvider AuthStateProvider
@inject IIncidenteService IncidenteService
@inject IAsignacionService AsignacionService
@inject NavigationManager Navigation

<PageTitle>Home Laboratorista</PageTitle>

<PushNotificationManager />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (esAsignador)
    {
        <MudText Typo="Typo.h3" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" Class="me-2" />
            Panel Supervisor - @userName
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Gestiona y supervisa los incidentes de tu facultad
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.h3" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Build" Class="me-2" />
            Panel Técnico - @userName
        </MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Resuelve los incidentes asignados a ti
        </MudText>
    }

    @if (isLoading)
    {
        <MudGrid>
            @for (var i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudSkeleton Height="150px" Animation="Animation.Wave" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@loadError</MudAlert>
    }
    else
    {
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Class="me-1" />
                                @(esAsignador ? "Incidentes Facultad" : "Asignadas a mí")
                            </MudText>
                            <MudText Typo="Typo.h3">@totalAsignadas</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">@(esAsignador ? "Total en mi facultad" : "Casos activos")</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="VerMisTareas">Ver detalles</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" Class="me-1" />
                                En Proceso
                            </MudText>
                            <MudText Typo="Typo.h3">@incidentesEnProceso</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Trabajando</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick='() => VerPorEstado("En Proceso")'>Ver casos</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardContent>
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="me-1" />
                                Completadas
                            </MudText>
                            <MudText Typo="Typo.h3">@incidentesResueltos</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Este mes</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Success" OnClick='() => VerPorEstado("Resuelto")'>Ver historial</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    <MudPaper Elevation="3" Class="mt-6 pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Acciones Rápidas</MudText>
        <MudStack Row="true" Spacing="3" Class="flex-wrap">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.List"
                       Href="/laboratorista/mis-tareas">
                Mis Asignaciones
            </MudButton>
            
            @if (esAsignador)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.Assignment"
                           Href="/laboratorista/todos-incidentes">
                    Gestionar Incidentes
                </MudButton>
            }
            
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Info" 
                       StartIcon="@Icons.Material.Filled.Book"
                       Href="/laboratorista/base-conocimiento">
                Base de Conocimiento
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (esAsignador)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4" Icon="@Icons.Material.Filled.Info">
            <strong>Rol Supervisor:</strong> Puedes asignar y reasignar incidentes a técnicos de tu facultad.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-4" Icon="@Icons.Material.Filled.Info">
            <strong>Rol Técnico:</strong> Enfócate en resolver los incidentes que te han sido asignados.
        </MudAlert>
    }
</MudContainer>

@code {
    private string userName = "";
    private bool esAsignador = false;
    private int? userId;
    private bool isLoading = true;
    private string? loadError;

    private int totalAsignadas = 0;
    private int incidentesEnProceso = 0;
    private int incidentesResueltos = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verificar rol
        if (!user.IsInRole("Laboratorista"))
        {
            Console.WriteLine($"[HomeLaboratorista] Usuario no tiene rol Laboratorista, redirigiendo");
            Navigation.NavigateTo("/login");
            return;
        }

        userName = user.Identity?.Name ?? "Usuario";
        userId = user.GetUserId();
        
        // Verificar si es Supervisor (EsAsignador = 1)
        var esAsignadorClaim = user.Claims.FirstOrDefault(c => c.Type == "EsAsignador");
        
        Console.WriteLine($"[HomeLaboratorista] Claims disponibles:");
        foreach (var claim in user.Claims)
        {
            Console.WriteLine($"  - {claim.Type}: {claim.Value}");
        }
        
        if (esAsignadorClaim != null && !string.IsNullOrEmpty(esAsignadorClaim.Value))
        {
            bool.TryParse(esAsignadorClaim.Value, out esAsignador);
        }
        
        Console.WriteLine($"[HomeLaboratorista] Usuario: {userName}, EsAsignador Claim: {esAsignadorClaim?.Value ?? "NULL"}, EsAsignador Parsed: {esAsignador}");

        if (userId.HasValue)
        {
            await CargarEstadisticas();
        }

        isLoading = false;
    }

    private async Task CargarEstadisticas()
    {
        if (!userId.HasValue) return;

        try
        {
            List<IncidentManagement.Application.DTOs.IncidenteDto> incidentes;

            if (esAsignador)
            {
                // Supervisor: ver todos los incidentes de su facultad
                var usuario = await IncidenteService.GetIncidentesByTecnicoAsync(userId.Value); // Para obtener la facultad
                incidentes = (await IncidenteService.GetAllIncidentesAsync()).ToList(); // Filtrar después si es necesario
            }
            else
            {
                // Técnico: solo incidentes asignados a él
                incidentes = (await IncidenteService.GetIncidentesByTecnicoAsync(userId.Value)).ToList();
            }

            totalAsignadas = incidentes.Count;
            incidentesEnProceso = incidentes.Count(i => i.Estado == "En Proceso");
            
            var primerDiaMes = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
            incidentesResueltos = incidentes.Count(i => 
                (i.Estado == "Resuelto" || i.Estado == "Cerrado") && 
                i.FechaResolucion.HasValue && 
                i.FechaResolucion.Value >= primerDiaMes);
        }
        catch (Exception ex)
        {
            loadError = $"Error al cargar estadísticas: {ex.Message}";
            Console.WriteLine($"[HomeLaboratorista] Error: {ex}");
        }
    }

    private void VerMisTareas()
    {
        if (esAsignador)
        {
            Navigation.NavigateTo("/laboratorista/todos-incidentes");
        }
        else
        {
            Navigation.NavigateTo("/laboratorista/mis-tareas");
        }
    }

    private void VerPorEstado(string estado)
    {
        Navigation.NavigateTo($"/laboratorista/mis-tareas?estado={estado}");
    }
}
