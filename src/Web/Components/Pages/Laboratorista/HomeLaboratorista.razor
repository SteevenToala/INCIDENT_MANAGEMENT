@page "/laboratorista/home"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Home Laboratorista</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.Build" Class="me-2" />
        Panel Laboratorista - @userName
    </MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
                        Asignadas
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                    <MudText Typo="Typo.body2">Casos activos</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Construction" Color="Color.Warning" />
                        En Proceso
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                    <MudText Typo="Typo.body2">Trabajando</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Done" Color="Color.Success" />
                        Completadas
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                    <MudText Typo="Typo.body2">Este mes</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="3" Class="mt-6 pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Acciones</MudText>
        <MudStack Row="true" Spacing="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.List">
                Mis Asignaciones
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Book">
                Base de Conocimiento
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Update">
                Actualizar Estado
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string userName = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verificar rol
        if (!user.IsInRole("Laboratorista"))
        {
            Console.WriteLine($"[HomeLaboratorista] Usuario no tiene rol Laboratorista, redirigiendo");
            Navigation.NavigateTo("/login");
            return;
        }

        userName = user.Identity?.Name ?? "Usuario";
        Console.WriteLine($"[HomeLaboratorista] Autenticado: {userName}");
    }
}
