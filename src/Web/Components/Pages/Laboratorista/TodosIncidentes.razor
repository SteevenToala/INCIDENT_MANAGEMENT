@page "/laboratorista/todos-incidentes"
@attribute [Authorize(Roles = "Laboratorista")]
@rendermode InteractiveServer
@using MudBlazor
@using IncidentManagement.Application.Interfaces
@using IncidentManagement.Application.DTOs
@using IncidentManagement.Domain.Entities
@inject IIncidenteService IncidenteService
@inject ILaboratorioRepository LaboratorioRepository
@inject IUsuarioRepository UsuarioRepository
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Todos los Incidentes</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (!esAsignador)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <strong>Acceso Restringido:</strong> Solo los Supervisores pueden ver todos los incidentes. Como técnico, puedes ver tus tareas asignadas en "Mis tareas".
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/laboratorista/mis-tareas" StartIcon="@Icons.Material.Filled.Task">
            Ir a Mis Tareas
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.h4" Class="mb-2">Gestión de Incidentes</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
            Visualiza y asigna todos los incidentes de tu facultad
        </MudText>

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }
        else
        {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="1. Reportado" Icon="@Icons.Material.Filled.ReportProblem" BadgeData="@incidentesReportados.Count">
