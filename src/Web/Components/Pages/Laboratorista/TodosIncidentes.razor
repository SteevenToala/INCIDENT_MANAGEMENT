                            <MudChip Color="@GetPriorityColor(context.Prioridad)" Size="Size.Small">@context.Prioridad</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Reportado por">@context.EstudianteNombre</MudTd>
                        <MudTd DataLabel="Computadora">@context.ComputadoraNombre</MudTd>
                        <MudTd DataLabel="Laboratorio">@context.LaboratorioNombre</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaReporte.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerDetalle(context.IncidenteID))">
                                Ver Detalle
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" HideRowsPerPage="true" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body1" Class="pa-4">No hay incidentes con trabajo completado.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>
            
            <MudTabPanel Text="6. Cerrado" Icon="@Icons.Material.Filled.Lock" BadgeData="@incidentesCerrados.Count">
                <MudTable Items="@incidentesCerrados" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true"
                          Filter="new Func<IncidenteDto, bool>(FilterFunc)" 
                          SortLabel="Ordenar por"
                          RowsPerPage="10">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">6. Incidentes Cerrados</MudText>
                        <MudSpacer />
                        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                            <select @bind="laboratorioSeleccionadoId" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="">Todos los Laboratorios</option>
                                @foreach (var lab in laboratorios)
                                {
                                    <option value="@lab.LaboratorioID">@lab.Nombre</option>
                                }
                            </select>
                            <select @bind="rolSeleccionado" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="">Todos los roles</option>
                                <option value="Estudiante">Estudiantes</option>
                                <option value="Docente">Docentes</option>
                            </select>
                            <select @bind="criterioBusqueda" style="padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                <option value="todos">Buscar en todos</option>
                                <option value="codigo">Código</option>
                                <option value="titulo">Título</option>
                                <option value="descripcion">Descripción</option>
                                <option value="reportador">Reportado por</option>
                                <option value="computadora">Computadora</option>
                                <option value="laboratorio">Laboratorio</option>
                            </select>
                            <MudTextField @bind-Value="searchString" Placeholder="Buscar" Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                        </div>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.IncidenteID)">ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.CodigoIncidente)">Código</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.Titulo)">Título</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.Prioridad)">Prioridad</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.EstudianteNombre)">Reportado por</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.ComputadoraNombre)">Computadora</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.LaboratorioNombre)">Laboratorio</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<IncidenteDto, object>(x => x.FechaReporte)">Fecha</MudTableSortLabel></MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IncidenteID</MudTd>
                        <MudTd DataLabel="Código">@context.CodigoIncidente</MudTd>
                        <MudTd DataLabel="Título">@context.Titulo</MudTd>
                        <MudTd DataLabel="Prioridad">
                            <MudChip Color="@GetPriorityColor(context.Prioridad)" Size="Size.Small">@context.Prioridad</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Reportado por">@context.EstudianteNombre</MudTd>
                        <MudTd DataLabel="Computadora">@context.ComputadoraNombre</MudTd>
                        <MudTd DataLabel="Laboratorio">@context.LaboratorioNombre</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaReporte.ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerDetalle(context.IncidenteID))">
                                Ver Detalle
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} de {all_items}" HideRowsPerPage="true" />
                    </PagerContent>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body1" Class="pa-4">No hay incidentes resueltos.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
        }
    }
}
</MudContainer>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private int? userId;
    private int? facultadId;
    private bool esAsignador = false;
    private string searchString = "";
    private string laboratorioSeleccionadoId = "";
    private string rolSeleccionado = "";
    private string criterioBusqueda = "todos";
    
    private List<IncidenteDto> incidentesReportados = new();
    private List<IncidenteDto> incidentesPendientes = new();
    private List<IncidenteDto> incidentesAsignados = new();
    private List<IncidenteDto> incidentesIniciados = new();
    private List<IncidenteDto> incidentesCompletados = new();
    private List<IncidenteDto> incidentesResueltos = new();
    private List<IncidenteDto> incidentesCerrados = new();
    private List<Laboratorio> laboratorios = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userId = user.GetUserId();
        if (userId is null)
        {
            errorMessage = "No se pudo identificar al usuario.";
            isLoading = false;
            return;
        }

        // Verificar si es Supervisor
        var esAsignadorClaim = user.Claims.FirstOrDefault(c => c.Type == "EsAsignador");
        Console.WriteLine($"[TodosIncidentes] EsAsignadorClaim: {esAsignadorClaim?.Value ?? "NULL"}");
        
        if (esAsignadorClaim != null && !string.IsNullOrEmpty(esAsignadorClaim.Value))
        {
            esAsignador = bool.Parse(esAsignadorClaim.Value);
        }
        
        Console.WriteLine($"[TodosIncidentes] Usuario ID: {userId.Value}, EsAsignador: {esAsignador}");
        
        if (!esAsignador)
        {
            Console.WriteLine($"[TodosIncidentes] Usuario NO es supervisor - Acceso DENEGADO");
            isLoading = false;
            return; // No cargar datos si no es supervisor
        }
        
        // Obtener facultad del usuario
        var usuario = await UsuarioRepository.GetByIdAsync(userId.Value);
        if (usuario == null)
        {
            errorMessage = "No se pudo encontrar información del usuario.";
            isLoading = false;
            return;
        }
        
        if (!usuario.FacultadID.HasValue)
        {
            errorMessage = "Tu usuario no tiene una facultad asignada. Contacta al administrador.";
            isLoading = false;
            return;
        }
        
        facultadId = usuario.FacultadID.Value;
        Console.WriteLine($"[TodosIncidentes] Usuario: {usuario.NombreCompleto}, Email: {usuario.Email}, Facultad ID: {facultadId}, EsAsignador BD: {usuario.EsAsignador}");

        await CargarLaboratorios();
        await CargarIncidencias();
    }

    private async Task CargarLaboratorios()
    {
        try
        {
            var labs = await LaboratorioRepository.GetAllAsync();
            // Filtrar solo laboratorios de mi facultad
            laboratorios = labs.Where(l => l.FacultadID == facultadId).ToList();
            Console.WriteLine($"[TodosIncidentes] Laboratorios cargados: {laboratorios.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TodosIncidentes] Error cargando laboratorios: {ex.Message}");
        }
    }

    private async Task CargarIncidencias()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (!facultadId.HasValue)
            {
                errorMessage = "No se pudo determinar la facultad.";
                return;
            }
            
            // Mostrar todas las incidencias DE MI FACULTAD
            var todasIncidencias = await IncidenteService.GetIncidentesByFacultadAsync(facultadId.Value);
            
            Console.WriteLine($"[TodosIncidentes] Total incidencias: {todasIncidencias.Count()}");
            
            // Filtrar según el flujo completo basado en Estado y EstadoAsignacion (igual que GetEstadoActual)
            // Prioridad jerárquica: Cerrado > Resuelto > Completado > Aceptado > Pendiente > Reportado
            
            // 6. Cerrado (Estado: "Cerrado") - Máxima prioridad
            incidentesCerrados = todasIncidencias.Where(i => i.Estado == "Cerrado").ToList();
            
            // 5. Resuelto (Estado: "Resuelto") - Segunda prioridad
            incidentesResueltos = todasIncidencias.Where(i => i.Estado == "Resuelto" && i.Estado != "Cerrado").ToList();
            
            // 4. Trabajo Completado (EstadoAsignacion: "Completado" pero NO Resuelto/Cerrado)
            incidentesCompletados = todasIncidencias.Where(i => 
                i.EstadoAsignacion == "Completado" && i.Estado != "Resuelto" && i.Estado != "Cerrado"
            ).ToList();
            
            // 3. Trabajo Iniciado (EstadoAsignacion: "Aceptado" pero NO Completado/Resuelto/Cerrado)
            incidentesIniciados = todasIncidencias.Where(i => 
                i.EstadoAsignacion == "Aceptado" && i.EstadoAsignacion != "Completado" &&
                i.Estado != "Resuelto" && i.Estado != "Cerrado"
            ).ToList();
            
            // 2. Asignado (Ya no se usa - se movió a pestaña 1)
            incidentesAsignados = new List<IncidenteDto>();
            
            // 1. Reportado (Estado: "Abierto" sin asignar)
            incidentesReportados = todasIncidencias.Where(i => 
                i.Estado == "Abierto" && i.TecnicoID == null &&
                i.EstadoAsignacion != "Aceptado" && i.EstadoAsignacion != "Completado" &&
                i.Estado != "Resuelto" && i.Estado != "Cerrado"
            ).ToList();
            
            // 2. Pendiente de Aceptación (Asignado pero pendiente o sin estado de asignación)
            incidentesPendientes = todasIncidencias.Where(i => 
                i.TecnicoID != null && 
                (string.IsNullOrEmpty(i.EstadoAsignacion) || i.EstadoAsignacion == "Pendiente") &&
                i.EstadoAsignacion != "Aceptado" && i.EstadoAsignacion != "Completado" &&
                i.Estado != "Resuelto" && i.Estado != "Cerrado"
            ).ToList();
            
            Console.WriteLine($"[TodosIncidentes] Reportados: {incidentesReportados.Count}, Pendientes: {incidentesPendientes.Count}, Asignados: {incidentesAsignados.Count}, Iniciados: {incidentesIniciados.Count}, Completados: {incidentesCompletados.Count}, Resueltos: {incidentesResueltos.Count}, Cerrados: {incidentesCerrados.Count}");
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar las incidencias.";
            Console.WriteLine($"[TodosIncidentes] Error: {ex.Message}");
            Console.WriteLine($"[TodosIncidentes] Stack: {ex.StackTrace}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void VerDetalle(int incidenteId)
    {
        Navigation.NavigateTo($"/laboratorista/asignaciones/actualizar?id={incidenteId}");
    }

    private Color GetPriorityColor(string prioridad)
    {
        return prioridad switch
        {
            "Alta" => Color.Error,
            "Media" => Color.Warning,
            _ => Color.Info
        };
    }

    private bool FilterFunc(IncidenteDto incidente)
    {
        // Filtrar por laboratorio seleccionado
        if (!string.IsNullOrWhiteSpace(laboratorioSeleccionadoId))
        {
            if (int.TryParse(laboratorioSeleccionadoId, out int labId))
            {
                var labSeleccionado = laboratorios.FirstOrDefault(l => l.LaboratorioID == labId);
                if (labSeleccionado != null && incidente.LaboratorioNombre != labSeleccionado.Nombre)
                    return false;
            }
        }

        // Filtrar por rol del reportador
        if (!string.IsNullOrWhiteSpace(rolSeleccionado))
        {
            if (!incidente.RolReportador.Equals(rolSeleccionado, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        // Filtrar por texto de búsqueda según criterio
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return criterioBusqueda switch
        {
            "codigo" => incidente.CodigoIncidente?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            "titulo" => incidente.Titulo?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            "descripcion" => incidente.Descripcion?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            "reportador" => incidente.EstudianteNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            "computadora" => incidente.ComputadoraNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            "laboratorio" => incidente.LaboratorioNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true,
            _ => // "todos" - buscar en todos los campos
                incidente.CodigoIncidente?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.Titulo?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.Descripcion?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.EstudianteNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.ComputadoraNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.LaboratorioNombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
                incidente.Prioridad?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true
        };
    }
}
