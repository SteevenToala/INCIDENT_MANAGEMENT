@page "/administrativo/incidentes/detalle"
@attribute [Authorize(Roles = "Administrativo")]
@rendermode InteractiveServer
@using IncidentManagement.Application.Interfaces
@using IncidentManagement.Application.DTOs
@using IncidentManagement.Domain.Entities
@inject IIncidenteService IncidenteService
@inject IAsignacionService AsignacionService
@inject IAsignacionRepository AsignacionRepository
@inject IUsuarioRepository UsuarioRepository
@inject INotificacionService NotificacionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Detalle del Incidente</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" 
               Color="Color.Default" OnClick="Volver" Class="mb-3">
        Volver a Incidentes
    </MudButton>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (incidente != null)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Spacing="3">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <MudText Typo="Typo.h4">@incidente.CodigoIncidente</MudText>
                            <MudChip Color="@GetEstadoColor(incidente.Estado)" Size="Size.Large">
                                @incidente.Estado
                            </MudChip>
                        </div>
                        
                        <MudDivider />
                        
                        <MudText Typo="Typo.h5">@incidente.Titulo</MudText>
                        
                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudChip Icon="@Icons.Material.Filled.Flag" Color="@GetPrioridadColor(incidente.Prioridad)" Size="Size.Small">
                                Prioridad: @incidente.Prioridad
                            </MudChip>
                            @if (!string.IsNullOrEmpty(incidente.ServicioNombre))
                            {
                                <MudChip Icon="@Icons.Material.Filled.Build" Color="Color.Primary" Size="Size.Small">
                                    Servicio: @incidente.ServicioNombre
                                </MudChip>
                            }
                            <MudChip Icon="@Icons.Material.Filled.Computer" Size="Size.Small">
                                @incidente.ComputadoraNombre
                            </MudChip>
                            <MudChip Icon="@Icons.Material.Filled.Room" Size="Size.Small">
                                @incidente.LaboratorioNombre
                            </MudChip>
                        </MudStack>
                        
                        <MudText><strong>Descripción:</strong></MudText>
                        <MudPaper Elevation="0" Class="pa-3" Style="background-color: #f5f5f5;">
                            <MudText>@incidente.Descripcion</MudText>
                        </MudPaper>
                        
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudText><strong>Reportado por:</strong> @incidente.UsuarioReportador</MudText>
                                <MudText><strong>Rol:</strong> @incidente.RolReportador</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText><strong>Fecha reporte:</strong> @incidente.FechaReporte.ToString("dd/MM/yyyy HH:mm")</MudText>
                                @if (incidente.FechaResolucion.HasValue)
                                {
                                    <MudText><strong>Fecha resolución:</strong> @incidente.FechaResolucion.Value.ToString("dd/MM/yyyy HH:mm")</MudText>
                                }
                            </MudItem>
                        </MudGrid>

                        @if (asignacionActual != null)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.h6">Información de Asignación</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudText><strong>Asignado a:</strong> @asignacionActual.NombreTecnico</MudText>
                                    <MudText><strong>Tipo:</strong> @asignacionActual.TipoAsignacion</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText><strong>Estado asignación:</strong></MudText>
                                    <MudChip Color="@GetEstadoAsignacionColor(asignacionActual.EstadoAsignacion)" Size="Size.Small">
                                        @asignacionActual.EstadoAsignacion
                                    </MudChip>
                                    @if (asignacionActual.FechaAsignacion.HasValue)
                                    {
                                        <MudText><strong>Asignado:</strong> @asignacionActual.FechaAsignacion.Value.ToString("dd/MM/yyyy HH:mm")</MudText>
                                    }
                                </MudItem>
                            </MudGrid>

                            @if (!string.IsNullOrEmpty(asignacionActual.Notas))
                            {
                                <div>
                                    <MudText><strong>Notas de asignación:</strong></MudText>
                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: #f5f5f5;">
                                        <MudText Typo="Typo.body2">@asignacionActual.Notas</MudText>
                                    </MudPaper>
                                </div>
                            }

                            @* Si el incidente requiere experto, mostrar formulario de asignación *@
                            @if (incidente.Estado == "Requiere Experto" && asignacionActual.EstadoAsignacion == "Completado")
                            {
                                var expertosDisponibles = ObtenerExpertosPorServicio();
                                
                                <MudDivider Class="my-4" />
                                
                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    <strong>⚠️ Este incidente requiere un Técnico Experto</strong>
                                    <div>El laboratorista indicó que no puede resolver este incidente. Asigna a un experto según el tipo de servicio.</div>
                                </MudAlert>
                                
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="me-2" />
                                    Asignar a Técnico Experto
                                </MudText>

                                <MudStack Spacing="3">
                                    <div>
                                        <label for="tecnico-experto-select"><strong>Técnico Experto</strong></label>
                                        <select id="tecnico-experto-select" class="form-control" @bind="tecnicoSeleccionadoId" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                            <option value="">-- Seleccionar Experto --</option>
                                            @foreach (var tecnico in expertosDisponibles)
                                            {
                                                <option value="@tecnico.UsuarioID">@tecnico.NombreCompleto - @tecnico.Email</option>
                                            }
                                        </select>
                                        @if (incidente.ServicioNombre != null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2">
                                                🔍 Mostrando expertos para: @incidente.ServicioNombre
                                            </MudText>
                                        }
                                        @if (!expertosDisponibles.Any())
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Error">No hay técnicos expertos disponibles para este servicio</MudText>
                                        }
                                    </div>

                                    <MudTextField @bind-Value="notasAsignacion"
                                                  Label="Notas de Asignación (Opcional)"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Instrucciones o comentarios para el técnico experto..." />

                                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Large"
                                               OnClick="AsignarIncidente" Disabled="isSubmitting || string.IsNullOrEmpty(tecnicoSeleccionadoId)">
                                        @if (isSubmitting)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                            <span>Asignando...</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="me-2" />
                                            <span>Asignar a Experto</span>
                                        }
                                    </MudButton>
                                </MudStack>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                Este incidente aún no ha sido asignado a ningún técnico.
                            </MudAlert>
                            
                            @if (incidente.Estado != "Cerrado" && incidente.Estado != "Resuelto")
                            {
                                <MudDivider Class="my-4" />
                                
                                @if (incidente.Estado == "Requiere Experto")
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                                        <strong>⚠️ Este incidente requiere un Técnico Experto</strong>
                                        <div>El laboratorista indicó que no puede resolver este incidente. Asigna a un experto según el tipo de servicio.</div>
                                    </MudAlert>
                                    
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Engineering" Class="me-2" />
                                        Asignar a Técnico Experto
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h6" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Class="me-2" />
                                        Asignar Incidente a Laboratorista
                                    </MudText>
                                }
                                
                                <MudStack Spacing="3">
                                    <div>
                                        @if (incidente.Estado == "Requiere Experto")
                                        {
                                            var expertosServicio = ObtenerExpertosPorServicio();
                                            
                                            <label for="tecnico-select"><strong>Técnico Experto</strong></label>
                                            <select id="tecnico-select" class="form-control" @bind="tecnicoSeleccionadoId" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                                <option value="">-- Seleccionar Experto --</option>
                                                @foreach (var tecnico in expertosServicio)
                                                {
                                                    <option value="@tecnico.UsuarioID">@tecnico.NombreCompleto - @tecnico.Email</option>
                                                }
                                            </select>
                                            @if (incidente.ServicioNombre != null)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2">
                                                    🔍 Mostrando expertos especializados en: @incidente.ServicioNombre
                                                </MudText>
                                            }
                                            @if (!expertosServicio.Any())
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error">No hay técnicos expertos disponibles para este servicio</MudText>
                                            }
                                        }
                                        else
                                        {
                                            <label for="tecnico-select"><strong>Laboratorista</strong></label>
                                            <select id="tecnico-select" class="form-control" @bind="tecnicoSeleccionadoId" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                                <option value="">-- Seleccionar Laboratorista --</option>
                                                @foreach (var tecnico in tecnicos)
                                                {
                                                    <option value="@tecnico.UsuarioID">@tecnico.NombreCompleto</option>
                                                }
                                            </select>
                                        }
                                    </div>

                                    <div>
                                        <label for="tipo-asignacion-select"><strong>Tipo de Asignación</strong></label>
                                        <select id="tipo-asignacion-select" class="form-control" @bind="tipoAsignacion" required style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
                                            <option value="">-- Seleccionar --</option>
                                            <option value="Urgente">Urgente</option>
                                            <option value="Normal">Normal</option>
                                            <option value="Programada">Programada</option>
                                        </select>
                                    </div>

                                    <MudTextField @bind-Value="notasAsignacion"
                                                  Label="Notas de Asignación (Opcional)"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Instrucciones o comentarios para el laboratorista..." />

                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                               OnClick="AsignarIncidente" Disabled="isSubmitting || string.IsNullOrEmpty(tecnicoSeleccionadoId)">
                                        @if (isSubmitting)
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                            <span>Asignando...</span>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Class="me-2" />
                                            <span>Asignar Incidente</span>
                                        }
                                    </MudButton>
                                </MudStack>
                            }
                        }

                        @* Gestión de Proveedores *@
                        @if (incidente.Estado == "Requiere Proveedor")
                        {
                            <MudDivider Class="my-4" />
                            <MudPaper Elevation="3" Class="pa-4" Style="background-color: #fff3cd; border-left: 4px solid #ff9800;">
                                <MudText Typo="Typo.h5" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Warning" Class="me-2" />
                                    Gestión con Proveedor Externo
                                </MudText>

                                <MudAlert Severity="Severity.Warning" Class="mb-3">
                                    <strong>⚠️ Incidente Escalado a Proveedor</strong>
                                    <div>El técnico experto no pudo resolver este incidente. Requiere contactar al proveedor externo.</div>
                                </MudAlert>

                                @if (asignacionActual != null && !string.IsNullOrEmpty(asignacionActual.Notas))
                                {
                                    <MudPaper Outlined="true" Class="pa-3 mb-3" Style="background-color: white;">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2"><strong>📋 Diagnóstico del Técnico Experto:</strong></MudText>
                                        <MudText Style="white-space: pre-line;">@asignacionActual.Notas</MudText>
                                    </MudPaper>
                                }

                                <MudText Typo="Typo.h6" Class="mb-3">Registrar Gestión con Proveedor</MudText>

                                <MudStack Spacing="3">
                                    <MudTextField @bind-Value="notasProveedor"
                                                  Label="Notas de Seguimiento"
                                                  Variant="Variant.Outlined"
                                                  Lines="4"
                                                  Placeholder="Describe la gestión realizada con el proveedor (contacto, diagnóstico, solución, fechas, etc.)..."
                                                  Required="true" />

                                    <MudTextField @bind-Value="solucionProveedor"
                                                  Label="Solución Implementada por el Proveedor"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Placeholder="Describe la solución que implementó el proveedor..."
                                                  Required="true" />

                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large"
                                                   Style="flex: 1"
                                                   OnClick="ResolverConProveedor" 
                                                   Disabled="@(isSubmitting || string.IsNullOrWhiteSpace(notasProveedor) || string.IsNullOrWhiteSpace(solucionProveedor))">
                                            @if (isSubmitting)
                                            {
                                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="me-2" />
                                            }
                                            Marcar como Resuelto por Proveedor
                                        </MudButton>

                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large"
                                                   OnClick="@(() => { notasProveedor = ""; solucionProveedor = ""; })"
                                                   Disabled="isSubmitting">
                                            Limpiar
                                        </MudButton>
                                    </MudStack>

                                    <MudText Typo="Typo.caption" Color="Color.Info">
                                        💡 <strong>Tip:</strong> Al marcar como resuelto, el incidente cambiará a estado "Resuelto" y se notificará al estudiante.
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        }

                        @if (incidente.FechaResolucion.HasValue)
                        {
                            var tiempoResolucion = (incidente.FechaResolucion.Value - incidente.FechaCreacion).TotalHours;
                            <MudDivider />
                            <MudText Typo="Typo.h6">Métricas</MudText>
                            <MudText><strong>Tiempo de resolución:</strong> @tiempoResolucion.ToString("F1") horas</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? IncidenteId { get; set; }

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private IncidenteDto? incidente;
    private AsignacionDto? asignacionActual;
    private List<Usuario> tecnicos = new();
    private List<Usuario> expertos = new();
    private string tecnicoSeleccionadoId = "";
    private string tipoAsignacion = "";
    private string notasAsignacion = "";
    private string notasProveedor = "";
    private string solucionProveedor = "";

    protected override async Task OnInitializedAsync()
    {
        if (!IncidenteId.HasValue)
        {
            errorMessage = "ID de incidente no proporcionado";
            isLoading = false;
            return;
        }

        await CargarTecnicos();
        await CargarIncidente();
    }

    private async Task CargarIncidente()
    {
        try
        {
            incidente = await IncidenteService.GetIncidenteByIdAsync(IncidenteId!.Value);
            
            if (incidente == null)
            {
                errorMessage = "Incidente no encontrado";
                return;
            }

            Console.WriteLine($"[DetalleIncidente] Incidente cargado:");
            Console.WriteLine($"[DetalleIncidente] - IncidenteID: {incidente.IncidenteID}");
            Console.WriteLine($"[DetalleIncidente] - ServicioID: {incidente.ServicioID}");
            Console.WriteLine($"[DetalleIncidente] - ServicioNombre: '{incidente.ServicioNombre}'");

            // Cargar asignación actual
            var asignaciones = await AsignacionRepository.GetByIncidenteIdAsync(IncidenteId.Value);
            var asignacion = asignaciones
                .OrderByDescending(a => a.FechaAsignacion)
                .FirstOrDefault();

            if (asignacion != null)
            {
                asignacionActual = new AsignacionDto
                {
                    AsignacionID = asignacion.AsignacionID,
                    IncidenteID = asignacion.IncidenteID,
                    UsuarioAsignadoID = asignacion.UsuarioAsignadoID,
                    NombreTecnico = asignacion.UsuarioAsignado?.NombreCompleto ?? "Desconocido",
                    TipoAsignacion = asignacion.TipoAsignacion,
                    EstadoAsignacion = asignacion.EstadoAsignacion,
                    FechaAsignacion = asignacion.FechaAsignacion,
                    FechaAceptacion = asignacion.FechaAceptacion,
                    FechaCompletacion = asignacion.FechaCompletacion,
                    Notas = asignacion.Notas
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el incidente: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/administrativo/incidentes");
    }

    private async Task CargarTecnicos()
    {
        try
        {
            var usuariosLab = await UsuarioRepository.GetByRolAsync("Laboratorista");
            tecnicos = usuariosLab.ToList();
            Console.WriteLine($"[DetalleIncidente] Laboratoristas cargados: {tecnicos.Count}");
            
            var usuariosExp = await UsuarioRepository.GetByRolAsync("TecnicoExperto");
            expertos = usuariosExp.ToList();
            Console.WriteLine($"[DetalleIncidente] Expertos cargados: {expertos.Count}");
            
            foreach (var exp in expertos)
            {
                Console.WriteLine($"[DetalleIncidente] Experto: {exp.NombreCompleto} - {exp.Email}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DetalleIncidente] Error al cargar técnicos: {ex.Message}");
        }
    }

    private List<Usuario> ObtenerExpertosPorServicio()
    {
        Console.WriteLine($"[DetalleIncidente] ObtenerExpertosPorServicio llamado");
        Console.WriteLine($"[DetalleIncidente] incidente null? {incidente == null}");
        Console.WriteLine($"[DetalleIncidente] ServicioNombre: {incidente?.ServicioNombre}");
        Console.WriteLine($"[DetalleIncidente] expertos null? {expertos == null}");
        Console.WriteLine($"[DetalleIncidente] expertos.Count: {expertos?.Count ?? 0}");
        
        if (incidente?.ServicioNombre == null || expertos == null || !expertos.Any())
        {
            Console.WriteLine($"[DetalleIncidente] Retornando lista vacía - validación inicial falló");
            return new List<Usuario>();
        }

        var servicio = incidente.ServicioNombre.ToLower();
        Console.WriteLine($"[DetalleIncidente] Filtrando expertos para servicio: '{servicio}'");

        // Filtrar expertos según el tipo de servicio
        var expertosServicio = expertos.Where(e =>
        {
            var email = e.Email.ToLower();
            Console.WriteLine($"[DetalleIncidente] Evaluando experto: {e.NombreCompleto} ({email})");

            // Reparación de Hardware -> expertos de hardware
            if (servicio.Contains("hardware") || servicio.Contains("reparación"))
            {
                var resultado = email.Contains("hardware");
                Console.WriteLine($"[DetalleIncidente] Servicio de hardware detectado. Resultado: {resultado}");
                return resultado;
            }

            // Instalación de Software -> expertos de software
            if (servicio.Contains("software") || servicio.Contains("instalación"))
            {
                var resultado = email.Contains("software");
                Console.WriteLine($"[DetalleIncidente] Servicio de software detectado. Resultado: {resultado}");
                return resultado;
            }

            // Mantenimiento -> expertos de redes/mantenimiento
            if (servicio.Contains("mantenimiento") || servicio.Contains("preventivo"))
            {
                var resultado = email.Contains("redes") || email.Contains("mantenimiento");
                Console.WriteLine($"[DetalleIncidente] Servicio de mantenimiento detectado. Resultado: {resultado}");
                return resultado;
            }

            // Si no coincide con ningún servicio conocido, no mostrar
            Console.WriteLine($"[DetalleIncidente] No coincide con ningún servicio conocido: excluido");
            return false;
        }).ToList();

        Console.WriteLine($"[DetalleIncidente] Total expertos filtrados: {expertosServicio.Count}");
        return expertosServicio;
    }

    private async Task AsignarIncidente()
    {
        if (incidente == null || string.IsNullOrEmpty(tecnicoSeleccionadoId)) return;

        isSubmitting = true;
        try
        {
            var esExperto = incidente.Estado == "Requiere Experto";
            
            var createDto = new CreateAsignacionDto
            {
                IncidenteID = incidente.IncidenteID,
                UsuarioAsignadoID = int.Parse(tecnicoSeleccionadoId),
                TipoAsignacion = esExperto ? "Experto" : tipoAsignacion,
                Notas = esExperto ? $"Asignado a técnico experto. {notasAsignacion}" : notasAsignacion
            };

            await AsignacionService.AsignarIncidenteAsync(createDto);
            
            // Si es experto, actualizar el estado a "Asignado a Experto"
            if (esExperto)
            {
                var updateDto = new ActualizarEstadoDto
                {
                    IncidenteID = incidente.IncidenteID,
                    Estado = "Asignado a Experto",
                    Comentarios = "Incidente asignado a técnico experto"
                };
                await IncidenteService.ActualizarEstadoAsync(updateDto);
            }
            
            // Notificar al estudiante
            if (incidente.UsuarioReportadorID.HasValue)
            {
                var tecnico = await UsuarioRepository.GetByIdAsync(int.Parse(tecnicoSeleccionadoId));
                var tipoTecnico = esExperto ? "técnico experto" : "técnico";
                await NotificacionService.CrearNotificacionAsync(
                    incidente.UsuarioReportadorID.Value,
                    incidente.IncidenteID,
                    esExperto ? "Incidente Asignado a Experto" : "Incidente Asignado",
                    $"Tu incidente '{incidente.CodigoIncidente}' ha sido asignado al {tipoTecnico} {tecnico?.NombreCompleto}. Pronto comenzará a trabajar en él.",
                    "Asignacion",
                    $"/estudiante/incidencias/detalle?id={incidente.IncidenteID}"
                );
            }
            
            Snackbar.Add($"Incidente asignado exitosamente al {(esExperto ? "técnico experto" : "laboratorista")}", Severity.Success);
            await CargarIncidente();
            
            // Limpiar formulario
            tecnicoSeleccionadoId = "";
            tipoAsignacion = "";
            notasAsignacion = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al asignar incidente: {ex.Message}", Severity.Error);
            Console.WriteLine($"[DetalleIncidente] Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ResolverConProveedor()
    {
        if (string.IsNullOrWhiteSpace(notasProveedor) || string.IsNullOrWhiteSpace(solucionProveedor))
        {
            Snackbar.Add("Completa las notas y la solución del proveedor", Severity.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            // Crear nota completa con información del proveedor
            var notasCompletas = $"RESUELTO POR PROVEEDOR EXTERNO\n\n" +
                               $"GESTIÓN REALIZADA:\n{notasProveedor}\n\n" +
                               $"SOLUCIÓN IMPLEMENTADA:\n{solucionProveedor}\n\n" +
                               $"Fecha de resolución: {DateTime.Now:dd/MM/yyyy HH:mm}";

            // Crear una nueva asignación administrativa para registrar la gestión del proveedor
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var adminId = authState.User.GetUserId();
            
            if (adminId.HasValue && asignacionActual != null)
            {
                // Completar la asignación actual del experto si no está completada
                if (asignacionActual.EstadoAsignacion != "Completado")
                {
                    await AsignacionService.CompletarAsignacionAsync(asignacionActual.AsignacionID, notasCompletas);
                }
            }

            // Cambiar el estado del incidente a "Resuelto"
            await IncidenteService.ActualizarEstadoAsync(new ActualizarEstadoDto
            {
                IncidenteID = incidente!.IncidenteID,
                Estado = "Resuelto",
                Comentarios = "Resuelto por proveedor externo"
            });

            // Notificar al estudiante
            if (incidente.UsuarioReportadorID.HasValue)
            {
                await NotificacionService.CrearNotificacionAsync(
                    incidente.UsuarioReportadorID.Value,
                    incidente.IncidenteID,
                    $"✓ Incidente {incidente.CodigoIncidente} Resuelto",
                    $"Tu incidente '{incidente.Titulo}' ha sido resuelto por el proveedor externo. Puedes revisar los detalles de la solución.",
                    "Resolucion"
                );
            }

            Snackbar.Add("Incidente marcado como resuelto por proveedor", Severity.Success);
            await Task.Delay(1000);
            await CargarIncidente();
            
            // Limpiar formulario
            notasProveedor = "";
            solucionProveedor = "";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al resolver incidente: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Color GetEstadoColor(string estado)
    {
        return estado switch
        {
            "Abierto" => Color.Warning,
            "En Proceso" => Color.Info,
            "Resuelto" => Color.Success,
            "Cerrado" => Color.Default,
            _ => Color.Default
        };
    }

    private Color GetPrioridadColor(string prioridad)
    {
        return prioridad switch
        {
            "Crítica" => Color.Error,
            "Alta" => Color.Warning,
            "Media" => Color.Info,
            "Baja" => Color.Default,
            _ => Color.Default
        };
    }

    private Color GetEstadoAsignacionColor(string? estado)
    {
        return estado switch
        {
            "Pendiente" => Color.Warning,
            "Aceptado" => Color.Info,
            "Completado" => Color.Success,
            _ => Color.Default
        };
    }
}
