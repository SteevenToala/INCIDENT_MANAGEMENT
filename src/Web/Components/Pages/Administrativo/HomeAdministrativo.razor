@page "/administrativo/home"
@attribute [Authorize(Roles = "Administrativo")]
@rendermode InteractiveServer
@using System.Security.Claims
@using IncidentManagement.Application.Interfaces
@using IncidentManagement.Application.DTOs
@using IncidentManagement.Domain.Entities
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IIncidenteService IncidenteService
@inject IUsuarioRepository UsuarioRepository
@inject IIncidenteRepository IncidenteRepository

<PageTitle>Dashboard Administrativo</PageTitle>

<PushNotificationManager />

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudStack Spacing="2" Class="mb-4">
        <MudText Typo="Typo.h4">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="me-2" />
            Dashboard Administrativo
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.subtitle1" Class="text-muted">@facultadNombre</MudText>
            <MudChip Icon="@Icons.Material.Filled.Person" Size="MudSize.Small">@userName</MudChip>
        </MudStack>
    </MudStack>

    <!-- Filtros -->
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <label style="display: block; margin-bottom: 8px; font-size: 14px; color: #666;">Período</label>
                <select @bind="periodoSeleccionado" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: white; font-size: 14px;">
                    <option value="hoy">Hoy</option>
                    <option value="semana">Esta Semana</option>
                    <option value="mes">Este Mes</option>
                    <option value="trimestre">Últimos 3 Meses</option>
                    <option value="año">Este Año</option>
                    <option value="todo">Todos los tiempos</option>
                </select>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <label style="display: block; margin-bottom: 8px; font-size: 14px; color: #666;">Estado</label>
                <select @bind="estadoFiltro" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: white; font-size: 14px;">
                    <option value="">Todos</option>
                    <option value="Abierto">Abiertos</option>
                    <option value="En Proceso">En Proceso</option>
                    <option value="Resuelto">Resueltos</option>
                    <option value="Cerrado">Cerrados</option>
                </select>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <label style="display: block; margin-bottom: 8px; font-size: 14px; color: #666;">Prioridad</label>
                <select @bind="prioridadFiltro" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: white; font-size: 14px;">
                    <option value="">Todas</option>
                    <option value="Crítica">Crítica</option>
                    <option value="Alta">Alta</option>
                    <option value="Media">Media</option>
                    <option value="Baja">Baja</option>
                </select>
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Style="display: flex; align-items: flex-end;">
                <MudButton Variant="Variant.Filled" Color="MudColor.Primary" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="AplicarFiltros">
                    Aplicar Filtros
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudGrid>
            @for (var i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudSkeleton Height="140px" Animation="Animation.Wave" />
                </MudItem>
            }
            <MudItem xs="12"><MudSkeleton Height="400px" Animation="Animation.Wave" /></MudItem>
        </MudGrid>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@loadError</MudAlert>
    }
    else
    {
        <!-- KPI Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">Total</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@totalIncidentes</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Incidentes</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.TrendingUp" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">Abiertos</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@incidentesAbiertos</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Sin atender</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.HourglassEmpty" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">En Proceso</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@incidentesEnProceso</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Trabajando</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.Engineering" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">Resueltos</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@incidentesResueltos</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Completados</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">Tasa Resolución</MudText>
                            <MudText Typo="Typo.h4" Style="font-weight: 600;">@tasaResolucion%</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Efectividad</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.Speed" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="4" Style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%); color: white;">
                    <MudCardContent Class="pb-0">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Style="opacity: 0.9;">Tiempo Promedio</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 600;">@tiempoPromedioResolucion</MudText>
                            <MudText Typo="Typo.body2" Style="opacity: 0.8;">Resolución</MudText>
                        </MudStack>
                    </MudCardContent>
                    <MudCardActions Class="pt-0 pb-2">
                        <MudIconButton Icon="@Icons.Material.Filled.Timer" Size="MudSize.Small" Style="color: white; opacity: 0.8;" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Gráficos principales -->
        <MudGrid Class="mb-4">
            <!-- Gráfico de tendencia temporal -->
            <MudItem xs="12" lg="8">
                <MudPaper Elevation="4" Class="pa-4" Style="height: 400px;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.ShowChart" Class="me-2" />
                            Tendencia de Incidentes
                        </MudText>
                        <MudChip Size="MudSize.Small" Color="MudColor.Info">@GetPeriodoLabel()</MudChip>
                    </MudStack>
                    <ApexChart TItem="IncidenteTendencia" Title="" Height="310">
                        <ApexPointSeries TItem="IncidenteTendencia" Items="@tendenciaIncidentes"
                                         Name="Creados" SeriesType="SeriesType.Line"
                                         XValue="@(e => e.Fecha.ToString("dd/MM"))"
                                         YAggregate="@(e => e.Sum(x => x.Creados))"
                                         OrderBy="@(e => e.X)" Color="#667eea" />
                        <ApexPointSeries TItem="IncidenteTendencia" Items="@tendenciaIncidentes"
                                         Name="Resueltos" SeriesType="SeriesType.Line"
                                         XValue="@(e => e.Fecha.ToString("dd/MM"))"
                                         YAggregate="@(e => e.Sum(x => x.Resueltos))"
                                         OrderBy="@(e => e.X)" Color="#43e97b" />
                    </ApexChart>
                </MudPaper>
            </MudItem>

            <!-- Gráfico de prioridades -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="4" Class="pa-4" Style="height: 400px;">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="me-2" />
                        Distribución por Prioridad
                    </MudText>
                    <ApexChart TItem="PrioridadData" Height="310">
                        <ApexPointSeries TItem="PrioridadData" Items="@prioridadData"
                                         SeriesType="SeriesType.Donut"
                                         Name="Incidentes"
                                         XValue="@(e => e.Prioridad)"
                                         YValue="@(e => (decimal)e.Cantidad)"
                                         OrderByDescending="@(e => e.Y)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Segunda fila de gráficos -->
        <MudGrid Class="mb-4">
            <!-- Gráfico de estados -->
            <MudItem xs="12" md="6" lg="4">
                <MudPaper Elevation="4" Class="pa-4" Style="height: 350px;">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="me-2" />
                        Estados de Incidentes
                    </MudText>
                    <ApexChart TItem="EstadoData" Height="260">
                        <ApexPointSeries TItem="EstadoData" Items="@estadoData"
                                         SeriesType="SeriesType.Bar"
                                         Name="Cantidad"
                                         XValue="@(e => e.Estado)"
                                         YValue="@(e => (decimal)e.Cantidad)"
                                         OrderByDescending="@(e => e.Y)" />
                    </ApexChart>
                </MudPaper>
            </MudItem>

            <!-- Top laboratorios con más incidentes -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="4" Class="pa-4" Style="height: 350px;">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Computer" Class="me-2" />
                        Laboratorios con Más Incidentes
                    </MudText>
                    <MudList Dense="true" Class="overflow-auto" Style="max-height: 270px;">
                        @foreach (var lab in topLaboratorios.Take(5))
                        {
                            <MudListItem>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@lab.Nombre</MudText>
                                    <MudChip Size="MudSize.Small" Color="MudColor.Primary">@lab.Cantidad</MudChip>
                                </MudStack>
                                <MudProgressLinear Color="MudColor.Primary" Value="@((lab.Cantidad / (double)Math.Max(totalIncidentes, 1)) * 100)" />
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>

            <!-- Incidentes recientes -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="4" Class="pa-4" Style="height: 350px;">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.NewReleases" Class="me-2" />
                        Incidentes Recientes
                    </MudText>
                    <MudList Dense="true" Class="overflow-auto" Style="max-height: 270px;">
                        @foreach (var inc in incidentesRecientes.Take(5))
                        {
                            <MudListItem Style="border-bottom: 1px solid #eee; padding: 8px 0;">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@inc.Titulo</MudText>
                                        <MudChip Size="MudSize.Small" Color="@GetPrioridadColor(inc.Prioridad)">@inc.Prioridad</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Class="text-muted">
                                        @inc.FechaCreacion.ToString("dd/MM/yyyy HH:mm") - @inc.Estado
                                    </MudText>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Acciones rápidas -->
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="4" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Class="me-2" />
                        Acciones Rápidas
                    </MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="MudColor.Primary" 
                                   StartIcon="@Icons.Material.Filled.List"
                                   OnClick="VerIncidentes">
                            Ver Todos los Incidentes
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudColor.Secondary" 
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="ExportarReporte">
                            Exportar Reporte
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudColor.Tertiary" 
                                   StartIcon="@Icons.Material.Filled.Analytics"
                                   OnClick="VerReportes">
                            Análisis Detallado
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="MudColor.Info" 
                                   StartIcon="@Icons.Material.Filled.Book"
                                   OnClick="VerBaseConocimientos">
                            Base de Conocimientos
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="MudColor.Success" 
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="AplicarFiltros">
                            Refrescar Dashboard
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private string userName = "";
    private string facultadNombre = "";
    private int? facultadId;
    private bool isLoading = true;
    private string? loadError;

    // Filtros
    private string periodoSeleccionado = "mes";
    private string estadoFiltro = "";
    private string prioridadFiltro = "";

    // KPIs principales
    private int totalIncidentes = 0;
    private int incidentesAbiertos = 0;
    private int incidentesEnProceso = 0;
    private int incidentesResueltos = 0;
    private int incidentesHoy = 0;
    private int incidentesCriticosAbiertos = 0;
    private string tiempoPromedioResolucion = "N/A";
    private string tiempoPromedioRespuesta = "N/A";
    private int tasaResolucion = 0;
    
    // Datos para gráficos
    private Dictionary<string, int> incidentesPorPrioridad = new();
    private List<IncidenteTendencia> tendenciaIncidentes = new();
    private List<PrioridadData> prioridadData = new();
    private List<EstadoData> estadoData = new();
    private List<LaboratorioData> topLaboratorios = new();
    private List<IncidenteDto> incidentesRecientes = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!user.IsInRole("Administrativo"))
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userName = user.Identity?.Name ?? "Usuario";
        
        // Obtener usuario y facultad
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdClaim, out int userId))
        {
            var usuario = await UsuarioRepository.GetByIdAsync(userId);
            if (usuario != null && usuario.FacultadID.HasValue)
            {
                facultadId = usuario.FacultadID.Value;
                facultadNombre = usuario.Facultad?.Nombre ?? "Sin Facultad";
                await CargarEstadisticas();
            }
            else
            {
                loadError = "Usuario no tiene facultad asignada";
            }
        }

        isLoading = false;
    }

    private async Task CargarEstadisticas()
    {
        if (!facultadId.HasValue) return;

        try
        {
            // Obtener incidentes directamente del repositorio con navegación incluida
            var todosIncidentes = (await IncidenteRepository.GetAllAsync()).Where(i => i.Computadora != null && i.Computadora.Laboratorio != null && i.Computadora.Laboratorio.FacultadID == facultadId.Value).ToList();
            
            // Aplicar filtro de período
            var fechaInicio = GetFechaInicioPeriodo();
            var incidentes = todosIncidentes.Where(i => i.FechaCreacion >= fechaInicio).ToList();

            // Aplicar filtros adicionales
            if (!string.IsNullOrEmpty(estadoFiltro))
            {
                incidentes = incidentes.Where(i => i.Estado == estadoFiltro).ToList();
            }
            if (!string.IsNullOrEmpty(prioridadFiltro))
            {
                incidentes = incidentes.Where(i => i.Prioridad == prioridadFiltro).ToList();
            }

            // KPIs principales
            totalIncidentes = incidentes.Count;
            incidentesAbiertos = incidentes.Count(i => i.Estado == "Abierto");
            incidentesEnProceso = incidentes.Count(i => i.Estado == "En Proceso");
            incidentesResueltos = incidentes.Count(i => i.Estado == "Resuelto" || i.Estado == "Cerrado");
            incidentesHoy = incidentes.Count(i => i.FechaCreacion.Date == DateTime.Today);
            incidentesCriticosAbiertos = incidentes.Count(i => i.Prioridad == "Crítica" && i.Estado == "Abierto");

            // Estadísticas por prioridad
            incidentesPorPrioridad = incidentes
                .GroupBy(i => i.Prioridad)
                .ToDictionary(g => g.Key, g => g.Count());

            // Datos para gráfico de prioridades
            prioridadData = incidentesPorPrioridad
                .Select(kvp => new PrioridadData { Prioridad = kvp.Key, Cantidad = kvp.Value })
                .OrderByDescending(p => p.Cantidad)
                .ToList();

            // Datos para gráfico de estados
            estadoData = incidentes
                .GroupBy(i => i.Estado)
                .Select(g => new EstadoData { Estado = g.Key, Cantidad = g.Count() })
                .OrderByDescending(e => e.Cantidad)
                .ToList();

            // Top laboratorios
            topLaboratorios = incidentes
                .Where(i => i.Computadora?.Laboratorio != null)
                .GroupBy(i => i.Computadora!.Laboratorio!.Nombre)
                .Select(g => new LaboratorioData { Nombre = g.Key, Cantidad = g.Count() })
                .OrderByDescending(l => l.Cantidad)
                .ToList();

            // Tendencia temporal
            GenerarTendenciaIncidentes(incidentes, fechaInicio);

            // Tiempo promedio de resolución
            var resueltos = incidentes.Where(i => i.FechaResolucion.HasValue).ToList();
            if (resueltos.Any())
            {
                var promedio = resueltos.Average(i => (i.FechaResolucion!.Value - i.FechaCreacion).TotalHours);
                tiempoPromedioResolucion = $"{promedio:F1}h";
            }

            // Tiempo promedio de respuesta (primer asignación)
            var conAsignaciones = incidentes.Where(i => i.Asignaciones != null && i.Asignaciones.Any()).ToList();
            if (conAsignaciones.Any())
            {
                var promedioRespuesta = conAsignaciones.Average(i => 
                {
                    var primeraAsignacion = i.Asignaciones!.OrderBy(a => a.FechaAsignacion).First();
                    return (primeraAsignacion.FechaAsignacion - i.FechaCreacion).TotalHours;
                });
                tiempoPromedioRespuesta = $"{promedioRespuesta:F1}h";
            }
            else
            {
                tiempoPromedioRespuesta = "N/A";
            }

            // Tasa de resolución
            if (totalIncidentes > 0)
            {
                tasaResolucion = (int)((incidentesResueltos / (double)totalIncidentes) * 100);
            }

            // Incidentes recientes (convertir a DTOs)
            incidentesRecientes = incidentes
                .OrderByDescending(i => i.FechaCreacion)
                .Take(5)
                .Select(i => new IncidenteDto
                {
                    IncidenteID = i.IncidenteID,
                    Titulo = i.Titulo,
                    Prioridad = i.Prioridad,
                    Estado = i.Estado,
                    FechaCreacion = i.FechaCreacion
                })
                .ToList();
        }
        catch (Exception ex)
        {
            loadError = $"Error al cargar estadísticas: {ex.Message}";
        }
    }

    private void GenerarTendenciaIncidentes(List<Incidente> incidentes, DateTime fechaInicio)
    {
        var dias = (DateTime.Today - fechaInicio.Date).Days + 1;
        tendenciaIncidentes = new List<IncidenteTendencia>();

        for (int i = 0; i < dias; i++)
        {
            var fecha = fechaInicio.Date.AddDays(i);
            tendenciaIncidentes.Add(new IncidenteTendencia
            {
                Fecha = fecha,
                Creados = incidentes.Count(inc => inc.FechaCreacion.Date == fecha),
                Resueltos = incidentes.Count(inc => inc.FechaResolucion.HasValue && inc.FechaResolucion.Value.Date == fecha)
            });
        }
    }

    private DateTime GetFechaInicioPeriodo()
    {
        return periodoSeleccionado switch
        {
            "hoy" => DateTime.Today,
            "semana" => DateTime.Today.AddDays(-7),
            "mes" => DateTime.Today.AddMonths(-1),
            "trimestre" => DateTime.Today.AddMonths(-3),
            "año" => DateTime.Today.AddYears(-1),
            _ => DateTime.MinValue
        };
    }

    private string GetPeriodoLabel()
    {
