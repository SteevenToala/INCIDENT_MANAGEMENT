@page "/administrativo/home"
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Home Administrativo</PageTitle>

<PushNotificationManager />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="me-2" />
        Panel Administrativo - @userName
    </MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" />
                        Total Incidencias
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.Pending" Color="Color.Warning" />
                        Pendientes
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Primary" />
                        En Proceso
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h5">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        Resueltas
                    </MudText>
                    <MudText Typo="Typo.h3">0</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="3" Class="mt-6 pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Gestión</MudText>
        <MudStack Row="true" Spacing="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.List">
                Ver Incidencias
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AssignmentInd">
                Asignar Técnicos
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Analytics">
                Reportes
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string userName = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Verificar rol
        if (!user.IsInRole("Administrativo"))
        {
            Console.WriteLine($"[HomeAdministrativo] Usuario no tiene rol Administrativo, redirigiendo");
            Navigation.NavigateTo("/login");
            return;
        }

        userName = user.Identity?.Name ?? "Usuario";
        Console.WriteLine($"[HomeAdministrativo] Autenticado: {userName}");
    }
}
