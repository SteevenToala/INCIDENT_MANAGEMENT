@page "/login"
@rendermode InteractiveServer
@using IncidentManagement.Application.DTOs
@using IncidentManagement.Application.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@layout Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-center" Style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 16px;">
    <MudGrid Justify="Justify.Center" Style="width: 100%; max-width: 600px;">
        <MudItem xs="12">
            <MudPaper Elevation="25" Class="pa-4 pa-sm-6 pa-md-8" Style="border-radius: 16px; backdrop-filter: blur(10px); background: rgba(255, 255, 255, 0.95); max-width: 100%;">
                
                <div class="d-flex flex-column align-center mb-4 mb-md-6">
                    <MudIcon Icon="@Icons.Material.Filled.Computer" Size="Size.Large" Color="Color.Primary" Style="font-size: 3rem;" Class="mb-2 mb-md-3" />
                    <MudText Typo="Typo.h4" Class="d-block d-md-none" Align="Align.Center" Style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Sistema de Gestión
                    </MudText>
                    <MudText Typo="Typo.h3" Class="d-none d-md-block" Align="Align.Center" Style="font-weight: 700; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                        Sistema de Gestión
                    </MudText>
                    <MudText Typo="Typo.h6" Class="d-block d-md-none" Align="Align.Center" Color="Color.Primary" Style="font-weight: 500;">
                        de Incidentes
                    </MudText>
                    <MudText Typo="Typo.h5" Class="d-none d-md-block" Align="Align.Center" Color="Color.Primary" Style="font-weight: 500;">
                        de Incidentes
                    </MudText>
                    <MudText Typo="Typo.body2" Class="d-block d-md-none mt-1 mt-md-2" Align="Align.Center" Color="Color.Secondary" Style="font-weight: 400;">
                        Universidad - Laboratorios
                    </MudText>
                    <MudText Typo="Typo.body1" Class="d-none d-md-block mt-2" Align="Align.Center" Color="Color.Secondary" Style="font-weight: 400;">
                        Universidad - Laboratorios de Computación
                    </MudText>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Icon="@Icons.Material.Filled.Error" Elevation="2">
                        <strong>Error:</strong> @errorMessage
                    </MudAlert>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    
                    <MudTextField @bind-Value="loginModel.Email" 
                                  Label="Correo Electrónico" 
                                  Variant="Variant.Outlined" 
                                  Class="mb-4"
                                  Required="true"
                                  RequiredError="El correo es requerido"
                                  InputType="InputType.Email"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email"
                                  AdornmentColor="Color.Primary" />

                    <MudTextField @bind-Value="loginModel.Password" 
                                  Label="Contraseña" 
                                  Variant="Variant.Outlined" 
                                  Class="mb-6"
                                  Required="true"
                                  RequiredError="La contraseña es requerida"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  AdornmentColor="Color.Primary" />

                    <MudButton ButtonType="ButtonType.Submit" 
                               Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="@isLoading"
                               Style="height: 48px; border-radius: 8px; font-weight: 600; text-transform: none; font-size: 1rem;">
                        @if (isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                            <MudText Class="ms-2">Iniciando sesión...</MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                            <MudText>Iniciar Sesión</MudText>
                        }
                    </MudButton>
                </EditForm>

                <MudDivider Class="my-4 my-md-6" />

                <MudPaper Outlined="true" Class="pa-3 pa-md-4" Style="border-radius: 8px; background: rgba(103, 126, 234, 0.05);">
                    <MudText Typo="Typo.subtitle2" Align="Align.Center" Color="Color.Primary" Style="font-weight: 600;" Class="mb-2 mb-md-3">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                        Usuarios de Prueba
                    </MudText>
                    <MudStack Spacing="2">
                        <MudChip Icon="@Icons.Material.Filled.School" Color="Color.Info" Size="Size.Small" Style="width: 100%; justify-content: flex-start;">
                            Estudiante: estudiante1@uni.edu
                        </MudChip>
                        <MudChip Icon="@Icons.Material.Filled.Business" Color="Color.Warning" Size="Size.Small" Style="width: 100%; justify-content: flex-start;">
                            Administrativo: admin1@uni.edu
                        </MudChip>
                        <MudChip Icon="@Icons.Material.Filled.Engineering" Color="Color.Success" Size="Size.Small" Style="width: 100%; justify-content: flex-start;">
                            Laboratorista: lab1@uni.edu
                        </MudChip>
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                            <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Class="mr-1" />
                            Contraseña: <strong>pass123</strong>
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private string? errorMessage;

    private async Task HandleLogin()
    {
        // Validaciones
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(loginModel.Email))
        {
            Snackbar.Add("❌ Por favor ingresa tu correo electrónico", Severity.Error);
            return;
        }

        if (!loginModel.Email.Contains("@"))
        {
            Snackbar.Add("❌ El correo electrónico no es válido", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            Snackbar.Add("❌ Por favor ingresa tu contraseña", Severity.Error);
            return;
        }

        isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(loginModel);

            if (response.Success && response.Usuario != null)
            {
                Snackbar.Add($"✅ ¡Bienvenido, {response.Usuario.NombreCompleto}!", Severity.Success);

                // Pequeño delay para mostrar el mensaje
                await Task.Delay(300);

                // Redirigir según el rol
                var targetUrl = response.Usuario.RolNombre switch
                {
                    "Estudiante" => "/estudiante/home",
                    "Administrativo" => "/administrativo/home",
                    "Laboratorista" => "/laboratorista/home",
                    "Docente" => "/estudiante/home",
                    _ => "/login"
                };

                Navigation.NavigateTo(targetUrl, false);
            }
            else
            {
                errorMessage = response.Message ?? "Credenciales incorrectas";
                Snackbar.Add($"❌ {errorMessage}", Severity.Error);
                loginModel.Password = string.Empty; // Limpiar contraseña
                isLoading = false;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se puede conectar al servidor. Verifica tu conexión.";
            Snackbar.Add($"❌ {errorMessage}", Severity.Error);
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = "Ocurrió un error inesperado. Intenta nuevamente.";
            Snackbar.Add($"❌ Error: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error en login: {ex}");
            isLoading = false;
        }
    }
}
