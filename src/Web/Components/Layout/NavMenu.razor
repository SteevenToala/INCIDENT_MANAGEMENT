@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider

<MudPaper Elevation="4" Class="pa-4 nav-menu h-100 d-flex flex-column">
    @if (!isAuthenticated)
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">Bienvenido</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Inicia sesión para acceder a tus módulos.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" FullWidth="true">
                <MudIcon Icon="@Icons.Material.Filled.Login" Class="me-2" /> Iniciar sesión
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="1" Class="mb-4">
            <MudText Typo="Typo.caption" Class="text-muted">Sesión activa</MudText>
            <MudText Typo="Typo.h6">@userName</MudText>
            <MudChip Color="Color.Primary" Variant="Variant.Filled" Class="w-fit-content text-uppercase">@userRoleDisplay</MudChip>
        </MudStack>

        <div class="flex-grow-1 overflow-auto pe-1">
            @foreach (var section in menuSections)
            {
                <MudText Typo="Typo.subtitle2" Class="text-uppercase text-muted mt-3 mb-1">@(section.Title)</MudText>
                <MudNavMenu Dense="true" Class="mb-2">
                    @foreach (var item in section.Items)
                    {
                        <MudNavLink Href="@item.Href" Match="item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix">
                            <MudIcon Icon="@item.Icon" Class="me-2" /> @item.Label
                        </MudNavLink>
                    }
                </MudNavMenu>
            }
        </div>

        <form method="post" action="/auth/logout" class="w-100">
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" ButtonType="ButtonType.Submit" FullWidth="true">
                Cerrar sesión
            </MudButton>
        </form>
    }
</MudPaper>

@code {
    private readonly List<MenuSection> menuSections = new();
    private bool isAuthenticated;
    private string userName = string.Empty;
    private string userRole = string.Empty;
    private string userRoleDisplay = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        UpdateAuthenticationState(state);
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        UpdateAuthenticationState(state);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateAuthenticationState(AuthenticationState state)
    {
        var user = state.User;
        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            userName = string.Empty;
            userRole = string.Empty;
            userRoleDisplay = string.Empty;
            menuSections.Clear();
            return;
        }

        userName = user.Identity?.Name ?? user.FindFirstValue(ClaimTypes.Email) ?? "Usuario";
        userRole = user.FindFirstValue(ClaimTypes.Role) ?? "Usuario";
        
        // Verificar si es Supervisor
        var esAsignadorClaim = user.FindFirstValue("EsAsignador");
        var esAsignador = false;
        
        if (!string.IsNullOrEmpty(esAsignadorClaim))
        {
            bool.TryParse(esAsignadorClaim, out esAsignador);
        }
        
        // Cambiar display name para Laboratorista sin permisos de asignador
        if (userRole.Equals("Laboratorista", StringComparison.OrdinalIgnoreCase) && !esAsignador)
        {
            userRoleDisplay = "Usuario Experto";
        }
        else
        {
            userRoleDisplay = userRole;
        }
        
        Console.WriteLine($"[NavMenu] Usuario: {userName}, Rol: {userRole}, EsAsignador: {esAsignador}");

        menuSections.Clear();
        foreach (var section in BuildMenuForRole(userRole, esAsignador))
        {
            menuSections.Add(section);
        }
    }

    private static IEnumerable<MenuSection> BuildMenuForRole(string role, bool esAsignador = false)
    {
        var normalizedRole = role.ToLowerInvariant();

        yield return new MenuSection("Navegación", new[]
        {
            normalizedRole switch
            {
                "estudiante" => new MenuItem("Inicio", "/estudiante/home", Icons.Material.Filled.Home, true),
                "docente" => new MenuItem("Inicio", "/docente/home", Icons.Material.Filled.Home, true),
                "administrativo" => new MenuItem("Panel", "/administrativo/home", Icons.Material.Filled.Dashboard, true),
                "laboratorista" when esAsignador => new MenuItem("Panel Supervisor", "/laboratorista/home", Icons.Material.Filled.SupervisorAccount, true),
                "laboratorista" => new MenuItem("Panel Técnico", "/laboratorista/home", Icons.Material.Filled.Build, true),
                "tecnicoexperto" => new MenuItem("Panel Experto", "/tecnico-experto/mis-tareas", Icons.Material.Filled.Engineering, true),
                _ => new MenuItem("Inicio", "/", Icons.Material.Filled.Home, true)
            },
            new MenuItem("Notificaciones", "/notificaciones", Icons.Material.Filled.Notifications)
        });

        foreach (var extraSection in normalizedRole switch
        {
            "estudiante" => new[]
            {
                new MenuSection("Incidentes", new[]
                {
                    new MenuItem("Mis incidentes", "/estudiante/incidencias", Icons.Material.Filled.ListAlt),
                    new MenuItem("Reportar", "/estudiante/incidencias/nuevo", Icons.Material.Filled.AddCircle),
                }),
                new MenuSection("Recursos", new[]
                {
                    new MenuItem("Base de conocimiento", "/estudiante/base-conocimiento", Icons.Material.Filled.MenuBook)
                })
            },
            "docente" => new[]
            {
                new MenuSection("Incidencias", new[]
                {
                    new MenuItem("Reportar incidente", "/docente/incidencias/nuevo", Icons.Material.Filled.AddCircle),
                    new MenuItem("Mis solicitudes", "/docente/incidencias", Icons.Material.Filled.ListAlt)
                }),
                new MenuSection("Recursos", new[]
                {
                    new MenuItem("Base de conocimiento", "/docente/base-conocimiento", Icons.Material.Filled.MenuBook)
                })
            },
            "administrativo" => new[]
            {
                new MenuSection("Gestión", new[]
                {
                    new MenuItem("Incidentes", "/administrativo/incidentes", Icons.Material.Filled.Assignment),
                    new MenuItem("Reportes", "/administrativo/reportes", Icons.Material.Filled.Analytics)
                }),
                new MenuSection("Recursos", new[]
                {
                    new MenuItem("Base de conocimiento", "/administrativo/conocimientos", Icons.Material.Filled.MenuBook)
                })
            },
            "laboratorista" when esAsignador => new[]
            {
                new MenuSection("Incidentes", new[]
                {
                    new MenuItem("Mis tareas", "/laboratorista/mis-tareas", Icons.Material.Filled.Task),
                    new MenuItem("Gestionar incidentes", "/laboratorista/todos-incidentes", Icons.Material.Filled.Assignment),
                }),
                new MenuSection("Recursos", new[]
                {
                    new MenuItem("Base de conocimiento", "/laboratorista/base-conocimiento", Icons.Material.Filled.MenuBook)
                })
            },
            "laboratorista" => new[]
            {
                new MenuSection("Incidentes", new[]
                {
                    new MenuItem("Mis tareas", "/laboratorista/mis-tareas", Icons.Material.Filled.Task)
                }),
                new MenuSection("Recursos", new[]
                {
                    new MenuItem("Base de conocimiento", "/laboratorista/base-conocimiento", Icons.Material.Filled.MenuBook)
                })
            },
            "tecnicoexperto" => new[]
            {
                new MenuSection("Incidentes Escalados", new[]
                {
                    new MenuItem("Mis tareas", "/tecnico-experto/mis-tareas", Icons.Material.Filled.Engineering)
                })
            },
            _ => Array.Empty<MenuSection>()
        })
        {
            yield return extraSection;
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }

    private record MenuItem(string Label, string Href, string Icon, bool MatchAll = false);
    private record MenuSection(string Title, IEnumerable<MenuItem> Items);
}

