# Configuración de Base de Datos
DB_SERVER=tu_servidor\tu_instancia
DB_NAME=IncidentManagementDB
DB_TRUSTED_CONNECTION=True

# Configuración JWT
JWT_SECRET_KEY=tu-clave-secreta-super-segura-de-al-menos-32-caracteres
JWT_ISSUER=IncidentManagementSystem
JWT_AUDIENCE=IncidentManagementUsers
JWT_EXPIRATION_MINUTES=1440

# Configuración de Notificaciones Push
PUSH_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
PUSH_VAPID_PRIVATE_KEY=tu-clave-privada-vapid
PUSH_VAPID_SUBJECT=mailto:admin@incidentmanagement.com
