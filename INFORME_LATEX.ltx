\begin{lstlisting}[caption={AuthService.cs - Lógica de Login con JWT}]
public async Task<AuthResponse> Login(LoginDto request)
{
    // Verificación de credenciales con Identity
    var user = await _userManager.FindByEmailAsync(request.Email);
    if (user == null || !await _userManager.CheckPasswordAsync(user, request.Password))
    {
        return new AuthResponse { Success = false, Message = "Credenciales inválidas" };
    }

    // Generación del Token de seguridad
    var key = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(_config["JWT_SECRET_KEY"]));
    var creds = new SigningCredentials(key, SecurityAlgorithms.HmacSha256);
    
    var token = new JwtSecurityToken(
        issuer: _config["JWT_ISSUER"],
        audience: _config["JWT_AUDIENCE"],
        claims: GetClaims(user),
        expires: DateTime.Now.AddMinutes(1440),
        signingCredentials: creds
    );

    return new AuthResponse { Success = true, Token = new JwtSecurityTokenHandler().WriteToken(token) };
}
\end{lstlisting}

